<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>203m Drag Race Physics & Telemetry Simulator - Pro Calibration</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & JetBrains Mono for Telemetry -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        telemetry: {
                            bg: '#090c10',
                            panel: '#11161f',
                            card: '#161c28',
                            border: '#232c3d',
                            accent: '#f59e0b',
                            red: '#ef4444',
                            green: '#10b981',
                            cyan: '#06b6d4',
                            purple: '#8b5cf6'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #090c10;
            color: #e2e8f0;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090c10;
        }
        ::-webkit-scrollbar-thumb {
            background: #232c3d;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #3b4963;
        }
        .telemetry-grid-bg {
            background-image: 
                linear-gradient(to right, rgba(35, 44, 61, 0.22) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(35, 44, 61, 0.22) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            opacity: 1;
        }
        .shift-flash {
            animation: flashRed 0.14s infinite alternate;
        }
        @keyframes flashRed {
            from { background-color: rgba(239, 68, 68, 0.2); border-color: #ef4444; }
            to { background-color: rgba(239, 68, 68, 0.85); border-color: #fca5a5; }
        }
        .racecore-card {
            background: radial-gradient(circle at top right, #18202c 0%, #0b0e14 65%, #07090d 100%);
        }
    </style>
</head>
<body class="min-h-screen telemetry-grid-bg selection:bg-amber-500 selection:text-black">

    <!-- Top Navigation / Telemetry Header -->
    <header class="sticky top-0 z-40 bg-telemetry-bg/95 backdrop-blur-md border-b border-telemetry-border">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="h-12 flex items-center justify-center">
                    <img src="data:image/png;base64," alt="PV Project Performance Lab" class="h-11 w-auto block drop-shadow-[0_0_6px_rgba(245,158,11,0.35)]">
                </div>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h1 class="text-lg sm:text-xl font-extrabold tracking-tight text-white">DRAGLAB <span class="text-amber-500 font-mono">203M</span> PRO CALIBRATION</h1>
                        <span class="px-2 py-0.5 text-[10px] font-mono font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 rounded-full">1000Hz / dt=1ms</span>
                        <span id="headerSensorBadge" class="px-2 py-0.5 text-[10px] font-mono font-bold uppercase tracking-wider bg-amber-500/15 text-amber-400 border border-amber-500/30 rounded-full">Sensor Lampu (28cm Rollout)</span>
                    </div>
                    <p class="text-xs text-slate-400">Simulasi Fisika Numerik & Kalibrasi Telemetri Lintasan Nyata (Christmas Tree Photocell & Racecore GNSS)</p>
                </div>
            </div>

            <!-- Quick Summary Pills -->
            <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                <div class="bg-telemetry-panel border border-telemetry-border rounded-lg px-3 py-1.5 flex items-center gap-2">
                    <span class="text-[11px] text-slate-400">PWR/WEIGHT:</span>
                    <span id="headerPwrWeight" class="text-xs font-mono font-bold text-amber-400">165.0 HP/Ton</span>
                </div>
                <div class="bg-telemetry-panel border border-telemetry-border rounded-lg px-3 py-1.5 flex items-center gap-2">
                    <span class="text-[11px] text-slate-400">SHIFT / LIMIT:</span>
                    <span id="headerRpmSummary" class="text-xs font-mono font-bold text-cyan-400">12800 / 13800 RPM</span>
                </div>
                <button id="btnResetDefaults" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-medium transition flex items-center gap-1.5">
                    <i class="fa-solid fa-rotate-left text-amber-400"></i> Reset Default
                </button>
                <button id="btnCopyReport" class="px-3.5 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-black font-bold text-xs transition flex items-center gap-1.5 shadow-lg shadow-amber-500/20">
                    <i class="fa-solid fa-copy"></i> Salin Time Slip
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-[1600px] mx-auto px-4 sm:px-6 py-5 space-y-5">

        <!-- PRESET SELECTOR BAR -->
        <div class="bg-telemetry-panel border border-telemetry-border rounded-2xl p-3.5 sm:p-4 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-500/40 flex items-center justify-center text-amber-400">
                    <i class="fa-solid fa-sliders text-sm"></i>
                </div>
                <div>
                    <h2 class="text-xs font-extrabold uppercase tracking-wider text-white">Preset Kalibrasi Cepat (Quick Setup)</h2>
                    <p class="text-[11px] text-slate-400">Pilih profil spesifikasi motor & lintasan atau ubah setiap parameter secara manual di bawah.</p>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 w-full md:w-auto">
                <button type="button" id="btnPreset1" class="preset-btn active-preset px-3.5 py-2 rounded-xl border-2 border-amber-500 bg-amber-500/10 text-left transition">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-extrabold text-amber-400">Preset 1: Drag Strip 33 HP</span>
                        <span class="text-[10px] font-mono bg-amber-500 text-black font-bold px-1.5 py-0.5 rounded">60ft ~1.80s</span>
                    </div>
                    <div class="text-[10px] font-mono text-slate-300 mt-0.5">200kg | Shift 12.8k / Limit 13.8k RPM</div>
                </button>
                <button type="button" id="btnPreset2" class="preset-btn px-3.5 py-2 rounded-xl border border-telemetry-border bg-telemetry-card hover:border-cyan-500/50 text-left transition">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-extrabold text-white">Preset 2: Standar 30 HP</span>
                        <span class="text-[10px] font-mono bg-slate-800 text-cyan-400 font-bold px-1.5 py-0.5 rounded">Base Spec</span>
                    </div>
                    <div class="text-[10px] font-mono text-slate-400 mt-0.5">200kg | Primer 22/70 | Final 13/41</div>
                </button>
                <button type="button" id="btnPreset3" class="preset-btn px-3.5 py-2 rounded-xl border border-telemetry-border bg-telemetry-card hover:border-emerald-500/50 text-left transition">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-extrabold text-white">Preset 3: Kompetisi 38 HP</span>
                        <span class="text-[10px] font-mono bg-slate-800 text-emerald-400 font-bold px-1.5 py-0.5 rounded">185 kg</span>
                    </div>
                    <div class="text-[10px] font-mono text-slate-400 mt-0.5">Primer 22/72 | Shift 13.2k / Limit 14.2k</div>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- LEFT COLUMN: INPUT PARAMETERS (4 Columns on large screens) -->
            <section class="lg:col-span-4 space-y-5">

                <!-- 1. Transmission Shift Delay Selector -->
                <div class="bg-telemetry-panel border border-telemetry-border rounded-2xl p-4 sm:p-5 shadow-xl">
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="text-sm font-bold uppercase tracking-wider text-white flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-amber-500"></i> Sistem Transmisi & Jeda Gigi
                        </h2>
                        <span class="text-[11px] font-mono text-amber-400" id="activeShiftDelayBadge">70 ms</span>
                    </div>
                    <p class="text-xs text-slate-400 mb-3">Selama jeda perpindahan gigi, aliran torsi ke roda terputus (<span class="font-mono text-slate-300">F_drive = 0 N</span>) sehingga motor mengalami deselerasi akibat hambatan angin & ban.</p>

                    <div class="grid grid-cols-3 gap-2.5 mb-3">
                        <button type="button" data-mode="clutch" class="trans-mode-btn group relative flex flex-col items-center justify-center p-3 rounded-xl border border-telemetry-border bg-telemetry-card hover:border-red-500/60 transition text-center">
                            <span class="w-2.5 h-2.5 rounded-full bg-red-500 mb-1.5"></span>
                            <span class="text-xs font-bold text-white">Kopling</span>
                            <span class="text-[11px] font-mono text-red-400 font-semibold" id="lblClutchMs">200 ms</span>
                            <span class="text-[10px] text-slate-400 mt-0.5">Manual</span>
                        </button>
                        <button type="button" data-mode="quickshifter" class="trans-mode-btn active-mode group relative flex flex-col items-center justify-center p-3 rounded-xl border-2 border-amber-500 bg-amber-500/10 transition text-center">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 mb-1.5"></span>
                            <span class="text-xs font-bold text-white">Quickshifter</span>
                            <span class="text-[11px] font-mono text-amber-400 font-semibold" id="lblQsMs">70 ms</span>
                            <span class="text-[10px] text-slate-400 mt-0.5">ECU Cut</span>
                        </button>
                        <button type="button" data-mode="matic" class="trans-mode-btn group relative flex flex-col items-center justify-center p-3 rounded-xl border border-telemetry-border bg-telemetry-card hover:border-emerald-500/60 transition text-center">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 mb-1.5"></span>
                            <span class="text-xs font-bold text-white">Sistem Matic</span>
                            <span class="text-[11px] font-mono text-emerald-400 font-semibold" id="lblMaticMs">50 ms</span>
                            <span class="text-[10px] text-slate-400 mt-0.5">Seamless</span>
                        </button>
                    </div>

                    <!-- Custom Shift Times Input -->
                    <div class="grid grid-cols-3 gap-2 pt-2 border-t border-telemetry-border/60">
                        <div>
                            <label class="block text-[10px] font-mono text-slate-400 mb-1">Jeda Kopling (ms)</label>
                            <input type="number" id="inpDelayClutch" value="200" min="0" max="1000" step="5" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded-lg px-2.5 py-1.5 text-xs font-mono text-red-400 focus:outline-none focus:border-red-500">
                        </div>
                        <div>
                            <label class="block text-[10px] font-mono text-slate-400 mb-1">Jeda QS (ms)</label>
                            <input type="number" id="inpDelayQs" value="70" min="0" max="1000" step="5" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded-lg px-2.5 py-1.5 text-xs font-mono text-amber-400 focus:outline-none focus:border-amber-500">
                        </div>
                        <div>
                            <label class="block text-[10px] font-mono text-slate-400 mb-1">Jeda Matic (ms)</label>
                            <input type="number" id="inpDelayMatic" value="50" min="0" max="1000" step="5" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded-lg px-2.5 py-1.5 text-xs font-mono text-emerald-400 focus:outline-none focus:border-emerald-500">
                        </div>
                    </div>
                </div>

                <!-- 2. Engine, Separate Shift RPM vs Limit RPM, Mass & Wheel -->
                <div class="bg-telemetry-panel border border-telemetry-border rounded-2xl p-4 sm:p-5 shadow-xl space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-white flex items-center gap-2">
                        <i class="fa-solid fa-fire-flame-curved text-amber-500"></i> Mesin, Shift RPM vs Limit RPM & Bobot
                    </h2>

                    <!-- Horsepower & Power Mode -->
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs text-slate-300 font-medium mb-1">Horsepower Puncak (HP)</label>
                            <div class="relative">
                                <input type="number" id="inpHp" value="33" min="5" max="500" step="0.5" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded-lg pl-3 pr-10 py-2 text-sm font-mono font-bold text-amber-400 focus:outline-none focus:border-amber-500">
                                <span class="absolute right-3 top-2 text-xs font-mono text-slate-500">HP</span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs text-slate-300 font-medium mb-1">Efisiensi Transmisi</label>
                            <select id="inpHpType" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded-lg px-2.5 py-2 text-xs font-mono text-slate-200 focus:outline-none focus:border-amber-500">
                                <option value="1.00">Wheel HP Murni (100%)</option>
                                <option value="0.95" selected>Drag Chain Spec (&eta; = 95%)</option>
                                <option value="0.92">On-Crank Dyno (&eta; = 92%)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Engine RPM Characteristics (SEPARATED SHIFT RPM & LIMIT RPM) -->
                    <div class="bg-telemetry-card border border-telemetry-border rounded-xl p-3 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-200">Konfigurasi Putaran Mesin (RPM)</span>
                            <span class="text-[10px] font-mono text-slate-400">Terpisah: Oper Gigi vs Limiter</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2.5">
                            <div>
                                <label class="block text-[11px] text-slate-300 mb-1">Peak Power RPM</label>
                                <input type="number" id="inpPeakRpm" value="11500" min="4000" max="20000" step="100" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded-lg px-2.5 py-1.5 text-xs font-mono font-semibold text-white focus:outline-none focus:border-amber-500">
                                <span class="text-[10px] text-slate-500">Titik HP Maksimum</span>
                            </div>
                            <div>
                                <label class="block text-[11px] text-slate-300 mb-1">Launch RPM (Start)</label>
                                <input type="number" id="inpLaunchRpm" value="9500" min="2000" max="16000" step="100" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded-lg px-2.5 py-1.5 text-xs font-mono font-semibold text-cyan-400 focus:outline-none focus:border-cyan-500">
                                <span class="text-[10px] text-slate-500">RPM Lepas Kopling</span>
                            </div>
                            <div>
                                <label class="block text-[11px] text-amber-400 font-semibold mb-1">Shift RPM (Gigi 1–5)</label>
                                <input type="number" id="inpShiftRpm" value="12800" min="4500" max="22000" step="100" class="sim-input w-full bg-telemetry-bg border border-amber-500/50 rounded-lg px-2.5 py-1.5 text-xs font-mono font-bold text-amber-400 focus:outline-none focus:border-amber-500">
                                <span class="text-[10px] text-slate-400">Titik Oper Gigi 1 s/d 5</span>
                            </div>
                            <div>
                                <label class="block text-[11px] text-red-400 font-semibold mb-1">Limit RPM (Rev Limiter)</label>
                                <input type="number" id="inpLimitRpm" value="13800" min="4500" max="23000" step="100" class="sim-input w-full bg-telemetry-bg border border-red-500/50 rounded-lg px-2.5 py-1.5 text-xs font-mono font-bold text-red-400 focus:outline-none focus:border-red-500">
                                <span class="text-[10px] text-slate-400">Batas ECU Cut / Gigi 6</span>
                            </div>
                        </div>

                        <!-- Dynamic Warning Box for Shift RPM vs Limit RPM -->
                        <div id="rpmWarningBanner" class="hidden rounded-lg p-2.5 text-[11px] font-mono border"></div>
                    </div>

                    <!-- Mass Breakdown: Bike + Rider -->
                    <div class="pt-2 border-t border-telemetry-border/60">
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-xs font-medium text-slate-300">Bobot Keseluruhan</span>
                            <span class="text-xs font-mono font-bold text-emerald-400" id="lblTotalMass">200.0 kg</span>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-[11px] text-slate-400 mb-1">Bobot Motor (kg)</label>
                                <input type="number" id="inpBikeMass" value="130" min="40" max="400" step="1" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded-lg px-3 py-1.5 text-xs font-mono text-white focus:outline-none focus:border-amber-500">
                            </div>
                            <div>
                                <label class="block text-[11px] text-slate-400 mb-1">Bobot Rider (kg)</label>
                                <input type="number" id="inpRiderMass" value="70" min="30" max="200" step="1" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded-lg px-3 py-1.5 text-xs font-mono text-white focus:outline-none focus:border-amber-500">
                            </div>
                        </div>
                    </div>

                    <!-- Wheel Diameter -->
                    <div class="pt-2 border-t border-telemetry-border/60">
                        <div class="grid grid-cols-2 gap-3 items-center">
                            <div>
                                <label class="block text-xs text-slate-300 font-medium mb-1">Diameter Roda Belakang</label>
                                <div class="relative">
                                    <input type="number" id="inpWheelDia" value="584" min="300" max="800" step="1" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded-lg pl-3 pr-12 py-1.5 text-xs font-mono font-bold text-cyan-400 focus:outline-none focus:border-amber-500">
                                    <span class="absolute right-3 top-1.5 text-xs font-mono text-slate-500">mm</span>
                                </div>
                            </div>
                            <div class="bg-telemetry-card border border-telemetry-border rounded-lg p-2 text-[11px] font-mono text-slate-400">
                                <div>Jari-jari (r): <span id="lblWheelRadius" class="text-white">0.292 m</span></div>
                                <div>Keliling: <span id="lblWheelCirc" class="text-white">1.835 m</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Drivetrain & 6-Speed Gearbox Ratios -->
                <div class="bg-telemetry-panel border border-telemetry-border rounded-2xl p-4 sm:p-5 shadow-xl space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-white flex items-center gap-2">
                        <i class="fa-solid fa-gears text-amber-500"></i> Reduksi Primer, Final Gear & Rasio 1-6
                    </h2>

                    <!-- Primary Reduction & Final Sprocket -->
                    <div class="grid grid-cols-2 gap-3">
                        <div class="bg-telemetry-card border border-telemetry-border rounded-xl p-3">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="text-[11px] font-semibold text-slate-300">Gigi Primer</span>
                                <span id="lblPrimaryRatio" class="text-[11px] font-mono font-bold text-amber-400">3.182</span>
                            </div>
                            <div class="grid grid-cols-2 gap-1.5">
                                <div>
                                    <label class="block text-[10px] text-slate-400">Kruk As (T)</label>
                                    <input type="number" id="inpPrimDrive" value="22" min="10" max="50" step="1" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded px-2 py-1 text-xs font-mono text-white text-center">
                                </div>
                                <div>
                                    <label class="block text-[10px] text-slate-400">Kopling (T)</label>
                                    <input type="number" id="inpPrimDriven" value="70" min="30" max="120" step="1" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded px-2 py-1 text-xs font-mono text-white text-center">
                                </div>
                            </div>
                        </div>

                        <div class="bg-telemetry-card border border-telemetry-border rounded-xl p-3">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="text-[11px] font-semibold text-slate-300">Final Gear</span>
                                <span id="lblFinalRatio" class="text-[11px] font-mono font-bold text-cyan-400">3.154</span>
                            </div>
                            <div class="grid grid-cols-2 gap-1.5">
                                <div>
                                    <label class="block text-[10px] text-slate-400">Depan (T)</label>
                                    <input type="number" id="inpFrontSprocket" value="13" min="10" max="22" step="1" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded px-2 py-1 text-xs font-mono text-white text-center">
                                </div>
                                <div>
                                    <label class="block text-[10px] text-slate-400">Belakang (T)</label>
                                    <input type="number" id="inpRearSprocket" value="41" min="25" max="65" step="1" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded px-2 py-1 text-xs font-mono text-white text-center">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 6-Speed Transmission Ratios -->
                    <div>
                        <div class="flex items-center justify-between text-[11px] text-slate-400 mb-2 px-1">
                            <span>Gigi Transmisi (Drive / Driven)</span>
                            <span>Reduksi (Driven/Drive)</span>
                        </div>
                        <div class="space-y-2">
                            <!-- Gear 1 -->
                            <div class="grid grid-cols-12 gap-2 items-center bg-telemetry-card/70 border border-telemetry-border/80 rounded-lg px-2.5 py-1.5">
                                <span class="col-span-3 text-xs font-bold text-slate-200">Rasio 1</span>
                                <div class="col-span-6 flex items-center gap-1.5">
                                    <input type="number" id="g1Drive" value="10" min="8" max="40" class="sim-input w-full bg-telemetry-bg border border-telemetry-border rounded px-1.5 py-1 text-xs font-mono text-center text-white">
                                    <span class="text-slate-500 font-mono">/</span>
