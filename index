        function renderComparisonTable(params) {
            const tbody = document.getElementById('comparisonTableBody');
            const finishDist = params.trackLengthM;
            const rows = [
                { name: '60 ft (18.29m)', dist: 18.288 },
                { name: '100 Meter', dist: 100.0 },
                { name: '150 Meter', dist: 150.0 },
                { name: '201 Meter', dist: 201.0 },
                { name: `${finishDist} Meter (Finish)`, dist: finishDist, highlight: true }
            ];

            let html = rows.map(row => {
                const cRec = getCheckpointRecord(simulationResults.clutch, row.dist);
                const qRec = getCheckpointRecord(simulationResults.quickshifter, row.dist);
                const mRec = getCheckpointRecord(simulationResults.matic, row.dist);
                const diffTime = mRec.timeSec - cRec.timeSec;
                const diffSpeed = mRec.speedKmh - cRec.speedKmh;

                return `
                    <tr class="${row.highlight ? 'bg-[#00d8c8]/15 font-semibold' : 'hover:bg-[#0a1d24]'} transition">
                        <td class="py-2.5 px-3 text-white font-sans font-semibold flex items-center"><span class="pv-bullet"></span>${row.name}</td>
                        <td class="py-2.5 px-3">
                            <span class="text-white font-bold">${cRec.timeSec.toFixed(3)} s</span>
                            <span class="block text-[11px] text-slate-400">${cRec.speedKmh.toFixed(1)} km/h</span>
                        </td>
                        <td class="py-2.5 px-3">
                            <span class="text-[#00f0dc] font-bold">${qRec.timeSec.toFixed(3)} s</span>
                            <span class="block text-[11px] text-slate-300">${qRec.speedKmh.toFixed(1)} km/h</span>
                        </td>
                        <td class="py-2.5 px-3">
                            <span class="text-amber-400 font-bold">${mRec.timeSec.toFixed(3)} s</span>
                            <span class="block text-[11px] text-slate-300">${mRec.speedKmh.toFixed(1)} km/h</span>
                        </td>
                        <td class="py-2.5 px-3 text-right">
                            <span class="text-[#00f0dc] font-bold">${diffTime >= 0 ? '+' : ''}${diffTime.toFixed(3)} s</span>
                            <span class="block text-[11px] text-emerald-400">${diffSpeed >= 0 ? '+' : ''}${diffSpeed.toFixed(1)} km/h</span>
                        </td>
                    </tr>
                `;
