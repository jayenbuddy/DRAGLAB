            document.getElementById('dashSpeed').innerHTML = `${state.vKmh.toFixed(1)}<small class="text-xs text-slate-400 ml-0.5">km/h</small>`;
            document.getElementById('dashDist').innerHTML = `${state.x.toFixed(1)}<small class="text-xs text-slate-400 ml-0.5">m</small>`;
            document.getElementById('dashGear').textContent = `GEAR ${state.gear}`;
            document.getElementById('dashRpm').innerHTML = `${Math.round(state.rpm)}<small class="text-[10px] text-slate-400 ml-0.5">RPM</small>`;

            // Update Tachometer Bar Fill
            const gaugeMaxRpm = Math.max(params.limitRpm + 1200, params.shiftRpm + 1200, 15000);
            const fillPct = Math.min(100, Math.max(0, (state.rpm / gaugeMaxRpm) * 100));
            document.getElementById('rpmBarFill').style.width = `${fillPct}%`;

            const statusBox = document.getElementById('dashStatusBox');
