        function drawRaceTrackCanvas(timeSec) {
            const canvas = document.getElementById('raceTrackCanvas');
            if (!canvas) return;
            const rect = canvas.parentElement.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;

            const ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);

            const W = rect.width;
            const H = rect.height;
            const params = getInputParams();
            const maxDist = Math.max(params.trackLengthM, 203);

            ctx.fillStyle = '#04080a';
            ctx.fillRect(0, 0, W, H);

            // Subtle PV PROJECT Watermark on Track Asphalt
            ctx.save();
            ctx.font = 'italic 900 26px "Exo 2", sans-serif';
            ctx.fillStyle = 'rgba(0, 216, 200, 0.04)';
            ctx.textAlign = 'center';
            ctx.fillText('PV PROJECT PERFORMANCE LAB // 203M DRAG STRIP', W / 2, H / 2 + 8);
            ctx.restore();

            const padLeft = 58;
            const padRight = 68;
            const trackW = W - padLeft - padRight;

            const markers = [
                { d: 0, label: 'START' },
                { d: 18.288, label: '60FT' },
                { d: 100, label: '100M' },
                { d: 150, label: '150M' },
                { d: 201, label: '201M' },
                { d: maxDist, label: `${maxDist}M` }
            ];

            ctx.font = '600 10px "JetBrains Mono", monospace';
            markers.forEach((m, i) => {
                const mx = padLeft + (m.d / maxDist) * trackW;
                ctx.strokeStyle = i === markers.length - 1 ? '#00f0dc' : 'rgba(0, 216, 200, 0.18)';
                ctx.lineWidth = i === markers.length - 1 ? 2 : 1;
                ctx.setLineDash(i === markers.length - 1 ? [] : [4, 4]);
                ctx.beginPath();
                ctx.moveTo(mx, 22);
                ctx.lineTo(mx, H - 12);
                ctx.stroke();

                ctx.fillStyle = i === markers.length - 1 ? '#00f0dc' : '#7dd3fc';
                ctx.textAlign = 'center';
                ctx.fillText(m.label, mx, 15);
            });
            ctx.setLineDash([]);

            const lanes = [
                { key: 'clutch', name: `KOPLING (${params.delayClutchMs}ms)`, color: '#ff3b5c', y: 58 },
                { key: 'quickshifter', name: `QUICKSHIFTER (${params.delayQsMs}ms)`, color: '#00f0dc', y: 122 },
                { key: 'matic', name: `SISTEM MATIC (${params.delayMaticMs}ms)`, color: '#eab308', y: 186 }
            ];

            lanes.forEach(lane => {
                ctx.fillStyle = 'rgba(7, 20, 26, 0.65)';
                ctx.fillRect(10, lane.y - 22, W - 20, 44);

                ctx.strokeStyle = activeTransMode === lane.key ? lane.color : 'rgba(0, 216, 200, 0.22)';
                ctx.lineWidth = activeTransMode === lane.key ? 1.6 : 1;
                ctx.strokeRect(10, lane.y - 22, W - 20, 44);

                ctx.fillStyle = 'rgba(203, 213, 225, 0.72)';
                ctx.font = '700 10px "JetBrains Mono", monospace';
                ctx.textAlign = 'left';
                ctx.fillText(lane.name, 18, lane.y - 8);

                const sim = simulationResults[lane.key];
                if (!sim) return;
                const st = sampleTelemetryAtTime(sim, timeSec);
                const bx = padLeft + Math.min(1, st.x / maxDist) * trackW;

                const grad = ctx.createLinearGradient(padLeft, 0, bx, 0);
                grad.addColorStop(0, 'rgba(4, 8, 10, 0.1)');
                grad.addColorStop(1, lane.color + '66');
                ctx.fillStyle = grad;
                ctx.fillRect(padLeft, lane.y - 4, Math.max(0, bx - padLeft), 8);

                ctx.save();
                ctx.translate(bx, lane.y);

                if ((st.isShifting || st.isLimiterCut) && timeSec < sim.finishTime) {
                    ctx.fillStyle = 'rgba(255, 59, 92, 0.35)';
                    ctx.beginPath();
                    ctx.arc(0, 0, 16, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.fillStyle = '#fda4af';
                    ctx.font = '700 9px "JetBrains Mono", monospace';
                    ctx.textAlign = 'center';
                    ctx.fillText(st.isLimiterCut ? 'LIMIT!' : 'SHIFT!', 0, -13);
                }

                // Wheels
                ctx.fillStyle = '#04080a';
                ctx.strokeStyle = lane.color;
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(-9, 5, 5, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                ctx.beginPath();
                ctx.arc(9, 5, 5, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                // Chassis
                ctx.fillStyle = lane.color;
                ctx.beginPath();
                ctx.moveTo(-10, 5);
                ctx.lineTo(-3, -5);
                ctx.lineTo(11, -3);
                ctx.lineTo(9, 5);
                ctx.closePath();
                ctx.fill();
                ctx.restore();

                ctx.fillStyle = '#ffffff';
                ctx.font = '700 10px "JetBrains Mono", monospace';
                ctx.textAlign = 'left';
                const tagX = Math.min(W - 76, bx + 16);
                ctx.fillText(`G${st.gear} ${st.vKmh.toFixed(0)}km/h`, tagX, lane.y + 3);
            });
        }

        function startRaceAnimation() {
            if (animState.rafId) cancelAnimationFrame(animState.rafId);
            animState.running = true;
            animState.currentTime = 0;
            animState.lastFrameTs = performance.now();
            animState.speedMultiplier = parseFloat(document.getElementById('selSimSpeed').value) || 1.0;

            const btn = document.getElementById('btnStartRace');
            btn.innerHTML = '<i class="fa-solid fa-pause"></i> Pause';

            function step(now) {
                if (!animState.running) return;
                const dtReal = (now - animState.lastFrameTs) / 1000;
                animState.lastFrameTs = now;

                animState.currentTime += dtReal * animState.speedMultiplier;
                const scrubber = document.getElementById('raceTimeScrubber');

                if (animState.currentTime >= animState.maxTime) {
                    animState.currentTime = animState.maxTime;
                    scrubber.value = animState.currentTime;
                    updateDashboardAndTrackAtTime(animState.currentTime);
                    animState.running = false;
                    btn.innerHTML = '<i class="fa-solid fa-play"></i> Replay Race';
                    return;
                }

                scrubber.value = animState.currentTime;
                updateDashboardAndTrackAtTime(animState.currentTime);
                animState.rafId = requestAnimationFrame(step);
            }

            animState.rafId = requestAnimationFrame(step);
        }

        /***********************************************************************
         * 6. INTERACTIVE TELEMETRY & DYNO CHARTS (WITH SHIFT & LIMIT RPM LINES)
         ***********************************************************************/
        function drawTelemetryChart() {
            const canvas = document.getElementById('telemetryChartCanvas');
            if (!canvas) return;
            const rect = canvas.parentElement.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;

            const ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);

            const W = rect.width;
            const H = rect.height;
            const padL = 58, padR = 26, padT = 28, padB = 38;
            const plotW = W - padL - padR;
            const plotH = H - padT - padB;

            ctx.fillStyle = '#04080a';
            ctx.fillRect(0, 0, W, H);

            const params = getInputParams();
            const maxDist = Math.max(params.trackLengthM, 203);
            const maxTime = Math.max(
                simulationResults.clutch.finishTime,
                simulationResults.quickshifter.finishTime,
                simulationResults.matic.finishTime,
                5.0
            );

            if (activeChartTab === 'dyno') {
                drawDynoCurveChart(ctx, W, H, padL, padR, padT, padB, plotW, plotH, params);
                return;
            }

            let maxY = 160;
            if (activeChartTab === 'speed_dist' || activeChartTab === 'speed_time') {
                maxY = Math.ceil(Math.max(
                    simulationResults.matic.topSpeedKmh,
                    simulationResults.clutch.topSpeedKmh,
                    120
                ) / 20) * 20;
            } else if (activeChartTab === 'rpm') {
                maxY = Math.ceil((Math.max(params.limitRpm, params.shiftRpm) + 1200) / 2000) * 2000;
            } else if (activeChartTab === 'force') {
                maxY = Math.ceil(Math.max(simulationResults.matic.peakWheelForceN, 1000) / 250) * 250;
            }

            // Y-axis Grid Lines
            ctx.strokeStyle = 'rgba(0, 216, 200, 0.14)';
            ctx.lineWidth = 1;
            ctx.font = '500 10px "JetBrains Mono", monospace';
            ctx.fillStyle = '#94a3b8';

            const ySteps = 5;
            for (let i = 0; i <= ySteps; i++) {
                const val = (maxY / ySteps) * i;
                const py = padT + plotH - (i / ySteps) * plotH;
                ctx.beginPath();
                ctx.moveTo(padL, py);
                ctx.lineTo(padL + plotW, py);
                ctx.stroke();

                ctx.textAlign = 'right';
                ctx.fillText(Math.round(val), padL - 8, py + 3);
            }

            // X-axis Grid Lines (Distance or Time)
            if (activeChartTab === 'speed_time') {
                const tSteps = 8;
                for (let i = 0; i <= tSteps; i++) {
                    const tVal = (maxTime / tSteps) * i;
                    const px = padL + (i / tSteps) * plotW;
                    ctx.beginPath();
                    ctx.moveTo(px, padT);
                    ctx.lineTo(px, padT + plotH);
                    ctx.stroke();

                    ctx.textAlign = 'center';
                    ctx.fillText(`${tVal.toFixed(1)}s`, px, padT + plotH + 18);
                }
            } else {
                const xCheckpoints = [0, 18.288, 50, 100, 150, 201, maxDist];
                xCheckpoints.forEach(d => {
                    if (d > maxDist) return;
                    const px = padL + (d / maxDist) * plotW;
                    ctx.beginPath();
                    ctx.moveTo(px, padT);
                    ctx.lineTo(px, padT + plotH);
                    ctx.stroke();

                    ctx.textAlign = 'center';
                    const lbl = d === 18.288 ? '60ft' : `${Math.round(d)}m`;
                    ctx.fillText(lbl, px, padT + plotH + 18);
                });
            }

            const modes = [
                { key: 'clutch', color: '#ff3b5c', label: `Kopling (${params.delayClutchMs}ms)` },
                { key: 'quickshifter', color: '#00f0dc', label: `Quickshifter (${params.delayQsMs}ms)` },
                { key: 'matic', color: '#eab308', label: `Matic (${params.delayMaticMs}ms)` }
            ];

            // Plot Curves
            if (activeChartTab === 'speed_dist' || activeChartTab === 'speed_time') {
                modes.forEach(m => {
                    const tele = simulationResults[m.key].telemetry;
                    ctx.strokeStyle = m.color;
                    ctx.lineWidth = activeTransMode === m.key ? 2.6 : 1.5;
                    ctx.beginPath();
                    tele.forEach((pt, idx) => {
                        const px = activeChartTab === 'speed_time'
                            ? padL + (pt.t / maxTime) * plotW
                            : padL + (pt.x / maxDist) * plotW;
                        const py = padT + plotH - (pt.vKmh / maxY) * plotH;
                        if (idx === 0) ctx.moveTo(px, py);
                        else ctx.lineTo(px, py);
                    });
                    ctx.stroke();
                });
                drawLegend(ctx, padL + 12, padT + 10, modes);
            } else if (activeChartTab === 'rpm') {
                // Draw Reference Horizontal Line for Shift RPM (Tosca) & Limit RPM (Red)
                const pyShift = padT + plotH - (params.shiftRpm / maxY) * plotH;
                const pyLimit = padT + plotH - (params.limitRpm / maxY) * plotH;

                ctx.save();
                ctx.setLineDash([6, 4]);
                ctx.strokeStyle = 'rgba(0, 240, 220, 0.75)';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.moveTo(padL, pyShift);
                ctx.lineTo(padL + plotW, pyShift);
                ctx.stroke();
                ctx.fillStyle = '#00f0dc';
                ctx.textAlign = 'right';
                ctx.fillText(`SHIFT RPM (${params.shiftRpm})`, padL + plotW - 6, pyShift - 4);

                ctx.strokeStyle = 'rgba(255, 59, 92, 0.85)';
                ctx.beginPath();
                ctx.moveTo(padL, pyLimit);
                ctx.lineTo(padL + plotW, pyLimit);
                ctx.stroke();
                ctx.fillStyle = '#ff3b5c';
                ctx.fillText(`LIMIT RPM (${params.limitRpm})`, padL + plotW - 6, pyLimit - 4);
                ctx.restore();

                // Plot all 3 modes RPM curves (active mode bold)
                modes.forEach(m => {
                    const tele = simulationResults[m.key].telemetry;
                    ctx.strokeStyle = m.color;
                    ctx.lineWidth = activeTransMode === m.key ? 2.4 : 1.1;
                    ctx.globalAlpha = activeTransMode === m.key ? 1.0 : 0.45;
                    ctx.beginPath();
                    tele.forEach((pt, idx) => {
                        const px = padL + (pt.x / maxDist) * plotW;
                        const py = padT + plotH - (pt.rpm / maxY) * plotH;
                        if (idx === 0) ctx.moveTo(px, py);
                        else ctx.lineTo(px, py);
                    });
                    ctx.stroke();
                });
                ctx.globalAlpha = 1.0;
                drawLegend(ctx, padL + 12, padT + 10, modes);
            } else if (activeChartTab === 'force') {
                const activeTele = simulationResults[activeTransMode].telemetry;
                ctx.strokeStyle = '#00f0dc';
                ctx.lineWidth = 2;
                ctx.beginPath();
                activeTele.forEach((pt, idx) => {
                    const px = padL + (pt.x / maxDist) * plotW;
                    const py = padT + plotH - (pt.fDrive / maxY) * plotH;
                    if (idx === 0) ctx.moveTo(px, py);
                    else ctx.lineTo(px, py);
                });
                ctx.stroke();

                ctx.strokeStyle = '#ff3b5c';
                ctx.lineWidth = 2;
                ctx.beginPath();
                activeTele.forEach((pt, idx) => {
                    const px = padL + (pt.x / maxDist) * plotW;
                    const py = padT + plotH - (pt.fDragTotal / maxY) * plotH;
                    if (idx === 0) ctx.moveTo(px, py);
                    else ctx.lineTo(px, py);
                });
                ctx.stroke();

                drawLegend(ctx, padL + 12, padT + 10, [
                    { color: '#00f0dc', label: 'Gaya Dorong Roda (F_drive [N])' },
                    { color: '#ff3b5c', label: 'Hambatan Total (Angin + Ban + Slope [N])' }
                ]);
            }

            // Interactive Hover Crosshair
            if (chartHoverX !== null && chartHoverX >= padL && chartHoverX <= padL + plotW) {
                const fracX = (chartHoverX - padL) / plotW;
                ctx.strokeStyle = 'rgba(0, 240, 220, 0.5)';
                ctx.lineWidth = 1;
                ctx.setLineDash([4, 4]);
                ctx.beginPath();
                ctx.moveTo(chartHoverX, padT);
                ctx.lineTo(chartHoverX, padT + plotH);
                ctx.stroke();
                ctx.setLineDash([]);

                const tele = simulationResults[activeTransMode].telemetry;
                let nearest = tele[0];
                if (activeChartTab === 'speed_time') {
                    const hoverT = fracX * maxTime;
                    for (let pt of tele) {
                        if (Math.abs(pt.t - hoverT) < Math.abs(nearest.t - hoverT)) nearest = pt;
                    }
                } else {
                    const hoverDist = fracX * maxDist;
                    for (let pt of tele) {
                        if (Math.abs(pt.x - hoverDist) < Math.abs(nearest.x - hoverDist)) nearest = pt;
                    }
                }

                const tipW = 205, tipH = 72;
                const tipX = Math.min(W - tipW - 15, chartHoverX + 12);
                const tipY = padT + 16;
                ctx.fillStyle = 'rgba(6, 16, 21, 0.96)';
                ctx.strokeStyle = '#00d8c8';
                ctx.lineWidth = 1.2;
                ctx.fillRect(tipX, tipY, tipW, tipH);
                ctx.strokeRect(tipX, tipY, tipW, tipH);

                ctx.fillStyle = '#ffffff';
                ctx.textAlign = 'left';
                ctx.font = '700 10px "JetBrains Mono", monospace';
                ctx.fillText(`Jarak: ${nearest.x.toFixed(1)}m | t: ${nearest.t.toFixed(3)}s`, tipX + 8, tipY + 16);
                ctx.fillStyle = '#00f0dc';
                ctx.fillText(`Speed: ${nearest.vKmh.toFixed(1)} km/h (Gigi ${nearest.gear})`, tipX + 8, tipY + 34);
                ctx.fillStyle = nearest.isLimiterCut ? '#ff3b5c' : '#eab308';
                ctx.fillText(`RPM  : ${Math.round(nearest.rpm)} ${nearest.isLimiterCut ? '[LIMIT!]' : ''}`, tipX + 8, tipY + 52);
            }
        }

        function drawDynoCurveChart(ctx, W, H, padL, padR, padT, padB, plotW, plotH, params) {
            const minRpm = 4000;
            const maxRpm = Math.max(params.limitRpm + 1000, params.shiftRpm + 1000, 15000);
            const maxHpScale = Math.ceil((params.hp * 1.25) / 10) * 10;

            ctx.strokeStyle = 'rgba(0, 216, 200, 0.14)';
            ctx.lineWidth = 1;
            ctx.font = '500 10px "JetBrains Mono", monospace';
            ctx.fillStyle = '#94a3b8';

            for (let i = 0; i <= 5; i++) {
                const val = (maxHpScale / 5) * i;
                const py = padT + plotH - (i / 5) * plotH;
                ctx.beginPath();
                ctx.moveTo(padL, py);
                ctx.lineTo(padL + plotW, py);
                ctx.stroke();
                ctx.textAlign = 'right';
                ctx.fillText(`${Math.round(val)}`, padL - 8, py + 3);
            }

            const rpmSteps = 6;
            for (let i = 0; i <= rpmSteps; i++) {
                const r = minRpm + ((maxRpm - minRpm) / rpmSteps) * i;
                const px = padL + (i / rpmSteps) * plotW;
                ctx.beginPath();
                ctx.moveTo(px, padT);
                ctx.lineTo(px, padT + plotH);
                ctx.stroke();
                ctx.textAlign = 'center';
                ctx.fillText(`${Math.round(r)}`, px, padT + plotH + 18);
            }

            // Draw Vertical Markers for Peak RPM, Shift RPM, and Limit RPM
            const markers = [
                { rpm: params.peakRpm, label: 'PEAK HP', color: '#ffffff' },
                { rpm: params.shiftRpm, label: 'SHIFT RPM', color: '#00f0dc' },
                { rpm: params.limitRpm, label: 'LIMIT RPM', color: '#ff3b5c' }
            ];
            markers.forEach(m => {
                if (m.rpm >= minRpm && m.rpm <= maxRpm) {
                    const mx = padL + ((m.rpm - minRpm) / (maxRpm - minRpm)) * plotW;
                    ctx.save();
                    ctx.setLineDash([5, 4]);
                    ctx.strokeStyle = m.color;
                    ctx.beginPath();
                    ctx.moveTo(mx, padT);
                    ctx.lineTo(mx, padT + plotH);
                    ctx.stroke();
                    ctx.fillStyle = m.color;
                    ctx.textAlign = 'center';
                    ctx.fillText(m.label, mx, padT + 12);
                    ctx.restore();
                }
            });

            // Plot Horsepower Curve up to Limit RPM
            ctx.strokeStyle = '#00f0dc';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            for (let r = minRpm; r <= params.limitRpm; r += 100) {
                const eng = calculateEnginePowerAndTorque(r, params);
                const px = padL + ((r - minRpm) / (maxRpm - minRpm)) * plotW;
                const py = padT + plotH - (eng.hp / maxHpScale) * plotH;
                if (r === minRpm) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            }
            ctx.stroke();

            // Plot Torque Curve (Nm) up to Limit RPM
            ctx.strokeStyle = '#eab308';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            for (let r = minRpm; r <= params.limitRpm; r += 100) {
                const eng = calculateEnginePowerAndTorque(r, params);
                const px = padL + ((r - minRpm) / (maxRpm - minRpm)) * plotW;
                const py = padT + plotH - (eng.torqueNm / maxHpScale) * plotH;
                if (r === minRpm) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            }
            ctx.stroke();

            drawLegend(ctx, padL + 12, padT + 22, [
                { color: '#00f0dc', label: `Kurva Tenaga (Peak ${params.hp.toFixed(1)} HP @ ${params.peakRpm} RPM)` },
                { color: '#eab308', label: `Kurva Torsi Mesin (Nm) — Cut @ Limit ${params.limitRpm} RPM` }
            ]);
        }

        function drawLegend(ctx, x, y, items) {
            items.forEach((it, idx) => {
                const ly = y + idx * 18;
                ctx.fillStyle = it.color;
                ctx.fillRect(x, ly, 12, 3);
                ctx.fillStyle = '#e2e8f0';
                ctx.font = '600 10px "JetBrains Mono", monospace';
                ctx.textAlign = 'left';
                ctx.fillText(it.label, x + 18, ly + 4);
            });
        }

        /***********************************************************************
         * 7. APPLY PRESETS, CLIPBOARD & EVENT LISTENERS
         ***********************************************************************/
        function applyPresetConfig(presetKey) {
            const p = PRESET_CONFIGS[presetKey];
            if (!p) return;

            document.getElementById('inpHp').value = p.hp;
            document.getElementById('inpHpType').value = p.hpEfficiency.toFixed(2);
            document.getElementById('inpPeakRpm').value = p.peakRpm;
            document.getElementById('inpShiftRpm').value = p.shiftRpm;
            document.getElementById('inpLimitRpm').value = p.limitRpm;
            document.getElementById('inpLaunchRpm').value = p.launchRpm;
            document.getElementById('inpBikeMass').value = p.bikeMass;
            document.getElementById('inpRiderMass').value = p.riderMass;
            document.getElementById('inpWheelDia').value = p.wheelDiaMm;
            document.getElementById('inpPrimDrive').value = p.primDrive;
            document.getElementById('inpPrimDriven').value = p.primDriven;
            document.getElementById('inpFrontSprocket').value = p.frontSprocket;
            document.getElementById('inpRearSprocket').value = p.rearSprocket;

            p.gears.forEach((g, idx) => {
                document.getElementById(`g${idx + 1}Drive`).value = g.drive;
                document.getElementById(`g${idx + 1}Driven`).value = g.driven;
            });

            document.getElementById('inpDelayClutch').value = p.delayClutchMs;
            document.getElementById('inpDelayQs').value = p.delayQsMs;
            document.getElementById('inpDelayMatic').value = p.delayMaticMs;
            document.getElementById('inpRolloutMode').value = p.rolloutM.toFixed(2);
            document.getElementById('inpTireMu').value = p.tireMu;
            document.getElementById('inpFlywheelImpulse').value = p.flywheelImpulsePct;
            document.getElementById('inpWindSpeed').value = p.windSpeedKmh;
            document.getElementById('inpTrackSlope').value = p.trackSlopePct;
            document.getElementById('inpTrackLength').value = p.trackLengthM;
            document.getElementById('inpCdA').value = p.cdA;
            document.getElementById('inpCrr').value = p.crr;

            runAllSimulations();
        }

        function copyTimeSlipToClipboard() {
            const params = getInputParams();
            const textArea = document.createElement('textarea');
            textArea.value = buildFormattedTextReport(params);
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);

            const toast = document.getElementById('toastNotification');
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2600);
        }

        window.onload = function () {
            // Bind all numerical & select inputs
            document.querySelectorAll('.sim-input').forEach(inp => {
                inp.addEventListener('input', () => runAllSimulations());
                inp.addEventListener('change', () => runAllSimulations());
            });

            // Preset Buttons
            const highlightPresetBtn = (activeId) => {
                ['btnPreset1', 'btnPreset2', 'btnPreset3'].forEach(id => {
                    const b = document.getElementById(id);
                    if (id === activeId) {
                        b.className = 'preset-btn active-preset px-3.5 py-2 border-2 border-[#00d8c8] bg-[#00d8c8]/15 text-left transition';
                    } else {
                        b.className = 'preset-btn px-3.5 py-2 border border-[#00d8c8]/35 bg-[#09151b] hover:border-[#00d8c8] text-left transition';
                    }
                });
            };

            document.getElementById('btnPreset1').addEventListener('click', () => {
                highlightPresetBtn('btnPreset1');
                applyPresetConfig('preset1');
            });
            document.getElementById('btnPreset2').addEventListener('click', () => {
                highlightPresetBtn('btnPreset2');
                applyPresetConfig('preset2');
            });
            document.getElementById('btnPreset3').addEventListener('click', () => {
                highlightPresetBtn('btnPreset3');
                applyPresetConfig('preset3');
            });

            // Transmission Mode Selector Buttons
            document.querySelectorAll('.trans-mode-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    activeTransMode = btn.getAttribute('data-mode');
                    document.querySelectorAll('.trans-mode-btn').forEach(b => {
                        b.className = 'trans-mode-btn group relative flex flex-col items-center justify-center p-3 border border-[#00d8c8]/30 bg-[#09151b] hover:border-[#00d8c8] transition text-center';
                    });
                    btn.className = 'trans-mode-btn active-mode group relative flex flex-col items-center justify-center p-3 border-2 border-[#00d8c8] bg-[#00d8c8]/15 transition text-center';
                    runAllSimulations();
                });
            });

            // Chart Tab Buttons
            document.querySelectorAll('.chart-tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    activeChartTab = btn.getAttribute('data-chart');
                    document.querySelectorAll('.chart-tab-btn').forEach(b => {
                        b.className = 'chart-tab-btn px-3 py-1.5 text-xs font-mono font-bold text-slate-300 hover:text-[#00f0dc] transition';
                    });
                    btn.className = 'chart-tab-btn px-3 py-1.5 text-xs font-mono font-bold bg-[#00d8c8] text-black transition';
                    drawTelemetryChart();
                });
            });

            // Start / Pause Drag Race Animation
            document.getElementById('btnStartRace').addEventListener('click', () => {
                if (animState.running) {
                    animState.running = false;
                    document.getElementById('btnStartRace').innerHTML = '<i class="fa-solid fa-play"></i> Lanjutkan';
                } else {
                    startRaceAnimation();
                }
            });

            document.getElementById('btnResetRace').addEventListener('click', () => {
                animState.running = false;
                animState.currentTime = 0;
                document.getElementById('raceTimeScrubber').value = 0;
                document.getElementById('btnStartRace').innerHTML = '<i class="fa-solid fa-play"></i> Start Drag Race';
                updateDashboardAndTrackAtTime(0);
            });

            // Timeline Scrubber
            document.getElementById('raceTimeScrubber').addEventListener('input', (e) => {
                animState.running = false;
                document.getElementById('btnStartRace').innerHTML = '<i class="fa-solid fa-play"></i> Start Drag Race';
                animState.currentTime = parseFloat(e.target.value) || 0;
                updateDashboardAndTrackAtTime(animState.currentTime);
            });

            // Telemetry Chart Hover Crosshair
            const chartCanvas = document.getElementById('telemetryChartCanvas');
            chartCanvas.addEventListener('mousemove', (e) => {
                const rect = chartCanvas.getBoundingClientRect();
                chartHoverX = e.clientX - rect.left;
                drawTelemetryChart();
            });
            chartCanvas.addEventListener('mouseleave', () => {
                chartHoverX = null;
                drawTelemetryChart();
            });

            // Reset & Copy Buttons
            document.getElementById('btnResetDefaults').addEventListener('click', () => {
                highlightPresetBtn('btnPreset1');
                applyPresetConfig('preset1');
            });
            document.getElementById('btnCopyReport').addEventListener('click', copyTimeSlipToClipboard);
            document.getElementById('btnCopyTextBox').addEventListener('click', copyTimeSlipToClipboard);

            // Responsive Resize Handler
            window.addEventListener('resize', () => {
                updateDashboardAndTrackAtTime(animState.currentTime);
                drawTelemetryChart();
            });

            // Initial Simulation Run with Preset 1
            applyPresetConfig('preset1');
        };
    </script>
</body>
