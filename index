            const container = document.getElementById('checkpointCardsContainer');
            const finishDist = params.trackLengthM;
            const checkpointsList = [
                { label: '60 FT', sub: '18.29 m', dist: 18.288, accent: 'border-[#00d8c8]/45' },
                { label: '100 M', sub: 'Mid-Track 1', dist: 100.0, accent: 'border-[#00d8c8]/30' },
                { label: '150 M', sub: 'Mid-Track 2', dist: 150.0, accent: 'border-[#00d8c8]/30' },
                { label: '201 M', sub: 'Drag Std', dist: 201.0, accent: 'border-[#00d8c8]/50' },
                { label: `${finishDist} M`, sub: 'Total Finish', dist: finishDist, accent: 'border-2 border-[#00d8c8] shadow-[0_0_18px_rgba(0,216,200,0.2)]' }
            ];

            container.innerHTML = checkpointsList.map((cp, idx) => {
