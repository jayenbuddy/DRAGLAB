                            <div class="text-xl sm:text-2xl font-mono font-extrabold ${isFinal ? 'text-[#00f0dc]' : 'text-white'} tracking-tight">
                                ${rec.timeSec.toFixed(3)}<span class="text-xs font-normal text-slate-400 ml-0.5">s</span>
                            </div>
