            if (!p) return;

            document.getElementById('inpHp').value = p.hp;
            document.getElementById('inpHpType').value = p.hpEfficiency.toFixed(2);
            document.getElementById('inpPeakRpm').value = p.peakRpm;
            document.getElementById('inpShiftRpm').value = p.shiftRpm;
            document.getElementById('inpLimitRpm').value = p.limitRpm;
            document.getElementById('inpLaunchRpm').value = p.launchRpm;
            document.getElementById('inpBikeMass').value = p.bikeMass;
            document.getElementById('inpRiderMass').value = p.riderMass;
            document.getElementById('inpWheelDia').value = p.wheelDiaMm;
            document.getElementById('inpPrimDrive').value = p.primDrive;
            document.getElementById('inpPrimDriven').value = p.primDriven;
            document.getElementById('inpFrontSprocket').value = p.frontSprocket;
            document.getElementById('inpRearSprocket').value = p.rearSprocket;

