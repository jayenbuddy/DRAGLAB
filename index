            document.getElementById('inpFlywheelImpulse').value = p.flywheelImpulsePct;
            document.getElementById('inpWindSpeed').value = p.windSpeedKmh;
            document.getElementById('inpTrackSlope').value = p.trackSlopePct;
            document.getElementById('inpTrackLength').value = p.trackLengthM;
            document.getElementById('inpCdA').value = p.cdA;
            document.getElementById('inpCrr').value = p.crr;

            runAllSimulations();
