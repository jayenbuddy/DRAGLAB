        /***********************************************************************
         * 5. LIVE 203M DRAG STRIP CANVAS ANIMATION (3-LANE COMPARISON)
         ***********************************************************************/
        function sampleTelemetryAtTime(simRes, timeSec) {
            const arr = simRes.telemetry;
            if (!arr || arr.length === 0) return { t: 0, x: 0, vKmh: 0, rpm: 8500, gear: 1, isShifting: false, isLimiterCut: false };
            if (timeSec <= 0) return arr[0];
            if (timeSec >= arr[arr.length - 1].t) return arr[arr.length - 1];

            let low = 0, high = arr.length - 1;
            while (low <= high) {
                const mid = (low + high) >> 1;
                if (arr[mid].t < timeSec) low = mid + 1;
                else high = mid - 1;
            }
            const idx = Math.max(1, low);
            const p0 = arr[idx - 1];
            const p1 = arr[idx];
            const ratio = (timeSec - p0.t) / Math.max(1e-6, p1.t - p0.t);
            return {
                t: timeSec,
                x: p0.x + ratio * (p1.x - p0.x),
                vKmh: p0.vKmh + ratio * (p1.vKmh - p0.vKmh),
                rpm: p0.rpm + ratio * (p1.rpm - p0.rpm),
                gear: p1.gear,
                isShifting: p1.isShifting,
                isLimiterCut: p1.isLimiterCut
            };
        }

        function updateDashboardAndTrackAtTime(timeSec) {
            const activeSim = simulationResults[activeTransMode];
            if (!activeSim) return;
            const params = getInputParams();

            const state = sampleTelemetryAtTime(activeSim, timeSec);
            document.getElementById('dashTime').innerHTML = `${Math.min(timeSec, activeSim.finishTime).toFixed(3)}<small class="text-xs text-slate-400 ml-0.5">s</small>`;
            document.getElementById('dashSpeed').innerHTML = `${state.vKmh.toFixed(1)}<small class="text-xs text-slate-400 ml-0.5">km/h</small>`;
            document.getElementById('dashDist').innerHTML = `${state.x.toFixed(1)}<small class="text-xs text-slate-400 ml-0.5">m</small>`;
            document.getElementById('dashGear').textContent = `GEAR ${state.gear}`;
            document.getElementById('dashRpm').innerHTML = `${Math.round(state.rpm)}<small class="text-[10px] text-slate-400 ml-0.5">RPM</small>`;

            // Update Tachometer Bar Fill
            const gaugeMaxRpm = Math.max(params.limitRpm + 1200, params.shiftRpm + 1200, 15000);
            const fillPct = Math.min(100, Math.max(0, (state.rpm / gaugeMaxRpm) * 100));
            document.getElementById('rpmBarFill').style.width = `${fillPct}%`;

            const statusBox = document.getElementById('dashStatusBox');
            const statusText = document.getElementById('dashStatusText');

            if (timeSec >= activeSim.finishTime) {
                statusBox.className = 'bg-amber-500/20 border border-amber-500 rounded-lg p-2.5 text-center flex flex-col justify-center';
                statusText.className = 'text-xs font-mono font-extrabold text-amber-400 uppercase';
                statusText.textContent = 'FINISH LINE!';
            } else if (state.isLimiterCut) {
                statusBox.className = 'shift-flash border rounded-lg p-2.5 text-center flex flex-col justify-center';
                statusText.className = 'text-xs font-mono font-extrabold text-red-300 uppercase';
                statusText.textContent = 'REV LIMITER CUT!';
            } else if (state.isShifting) {
                statusBox.className = 'shift-flash border rounded-lg p-2.5 text-center flex flex-col justify-center';
                statusText.className = 'text-xs font-mono font-extrabold text-white uppercase';
                statusText.textContent = 'SHIFT CUT (0 N)';
            } else {
                statusBox.className = 'bg-telemetry-card border border-telemetry-border rounded-lg p-2.5 text-center flex flex-col justify-center';
                statusText.className = 'text-xs font-mono font-extrabold text-emerald-400 uppercase';
                statusText.textContent = 'FULL THROTTLE';
            }

            document.getElementById('lblScrubTime').textContent = `${timeSec.toFixed(2)}s`;
            drawRaceTrackCanvas(timeSec);
        }

        function drawRaceTrackCanvas(timeSec) {
            const canvas = document.getElementById('raceTrackCanvas');
            if (!canvas) return;
            const rect = canvas.parentElement.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;

            const ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);

            const W = rect.width;
            const H = rect.height;
            const params = getInputParams();
            const maxDist = Math.max(params.trackLengthM, 203);

            ctx.fillStyle = '#0b0f17';
            ctx.fillRect(0, 0, W, H);

            const padLeft = 58;
            const padRight = 68;
            const trackW = W - padLeft - padRight;

            const markers = [
                { d: 0, label: 'START' },
                { d: 18.288, label: '60FT' },
                { d: 100, label: '100M' },
                { d: 150, label: '150M' },
                { d: 201, label: '201M' },
                { d: maxDist, label: `${maxDist}M` }
            ];

            ctx.font = '600 10px "JetBrains Mono", monospace';
            markers.forEach((m, i) => {
                const mx = padLeft + (m.d / maxDist) * trackW;
                ctx.strokeStyle = i === markers.length - 1 ? '#f59e0b' : 'rgba(148, 163, 184, 0.2)';
                ctx.lineWidth = i === markers.length - 1 ? 2 : 1;
                ctx.setLineDash(i === markers.length - 1 ? [] : [4, 4]);
                ctx.beginPath();
                ctx.moveTo(mx, 22);
                ctx.lineTo(mx, H - 12);
                ctx.stroke();

                ctx.fillStyle = i === markers.length - 1 ? '#f59e0b' : '#64748b';
                ctx.textAlign = 'center';
                ctx.fillText(m.label, mx, 15);
            });
            ctx.setLineDash([]);

            const lanes = [
                { key: 'clutch', name: `KOPLING (${params.delayClutchMs}ms)`, color: '#ef4444', y: 58 },
                { key: 'quickshifter', name: `QUICKSHIFTER (${params.delayQsMs}ms)`, color: '#f59e0b', y: 122 },
                { key: 'matic', name: `SISTEM MATIC (${params.delayMaticMs}ms)`, color: '#10b981', y: 186 }
            ];

            lanes.forEach(lane => {
                ctx.fillStyle = 'rgba(30, 41, 59, 0.35)';
                ctx.fillRect(10, lane.y - 22, W - 20, 44);

                ctx.strokeStyle = activeTransMode === lane.key ? lane.color : 'rgba(51, 65, 85, 0.5)';
                ctx.lineWidth = activeTransMode === lane.key ? 1.5 : 1;
                ctx.strokeRect(10, lane.y - 22, W - 20, 44);

                ctx.fillStyle = 'rgba(148, 163, 184, 0.6)';
                ctx.font = '700 10px "JetBrains Mono", monospace';
                ctx.textAlign = 'left';
                ctx.fillText(lane.name, 18, lane.y - 8);

                const sim = simulationResults[lane.key];
                if (!sim) return;
                const st = sampleTelemetryAtTime(sim, timeSec);
                const bx = padLeft + Math.min(1, st.x / maxDist) * trackW;

                const grad = ctx.createLinearGradient(padLeft, 0, bx, 0);
                grad.addColorStop(0, 'rgba(15, 23, 42, 0.1)');
                grad.addColorStop(1, lane.color + '55');
                ctx.fillStyle = grad;
                ctx.fillRect(padLeft, lane.y - 4, Math.max(0, bx - padLeft), 8);

                ctx.save();
                ctx.translate(bx, lane.y);

                if ((st.isShifting || st.isLimiterCut) && timeSec < sim.finishTime) {
                    ctx.fillStyle = 'rgba(239, 68, 68, 0.35)';
                    ctx.beginPath();
                    ctx.arc(0, 0, 16, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.fillStyle = '#fca5a5';
                    ctx.font = '700 9px "JetBrains Mono", monospace';
                    ctx.textAlign = 'center';
                    ctx.fillText(st.isLimiterCut ? 'LIMIT!' : 'SHIFT!', 0, -13);
                }

                // Wheels
                ctx.fillStyle = '#0f172a';
                ctx.strokeStyle = lane.color;
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(-9, 5, 5, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                ctx.beginPath();
                ctx.arc(9, 5, 5, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                // Chassis
                ctx.fillStyle = lane.color;
                ctx.beginPath();
                ctx.moveTo(-10, 5);
                ctx.lineTo(-3, -5);
                ctx.lineTo(11, -3);
                ctx.lineTo(9, 5);
                ctx.closePath();
                ctx.fill();
                ctx.restore();

                ctx.fillStyle = '#f8fafc';
                ctx.font = '700 10px "JetBrains Mono", monospace';
                ctx.textAlign = 'left';
                const tagX = Math.min(W - 76, bx + 16);
                ctx.fillText(`G${st.gear} ${st.vKmh.toFixed(0)}km/h`, tagX, lane.y + 3);
            });
        }

        function startRaceAnimation() {
            if (animState.rafId) cancelAnimationFrame(animState.rafId);
            animState.running = true;
            animState.currentTime = 0;
            animState.lastFrameTs = performance.now();
            animState.speedMultiplier = parseFloat(document.getElementById('selSimSpeed').value) || 1.0;

            const btn = document.getElementById('btnStartRace');
            btn.innerHTML = '<i class="fa-solid fa-pause"></i> Pause';

            function step(now) {
                if (!animState.running) return;
                const dtReal = (now - animState.lastFrameTs) / 1000;
                animState.lastFrameTs = now;

                animState.currentTime += dtReal * animState.speedMultiplier;
                const scrubber = document.getElementById('raceTimeScrubber');

                if (animState.currentTime >= animState.maxTime) {
                    animState.currentTime = animState.maxTime;
                    scrubber.value = animState.currentTime;
                    updateDashboardAndTrackAtTime(animState.currentTime);
                    animState.running = false;
                    btn.innerHTML = '<i class="fa-solid fa-play"></i> Replay Race';
                    return;
                }

                scrubber.value = animState.currentTime;
                updateDashboardAndTrackAtTime(animState.currentTime);
                animState.rafId = requestAnimationFrame(step);
            }

            animState.rafId = requestAnimationFrame(step);
        }

        /***********************************************************************
         * 6. INTERACTIVE TELEMETRY & DYNO CHARTS (WITH SHIFT & LIMIT RPM LINES)
         ***********************************************************************/
        function drawTelemetryChart() {
            const canvas = document.getElementById('telemetryChartCanvas');
            if (!canvas) return;
            const rect = canvas.parentElement.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;

            const ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);

            const W = rect.width;
            const H = rect.height;
            const padL = 58, padR = 26, padT = 28, padB = 38;
            const plotW = W - padL - padR;
            const plotH = H - padT - padB;

            ctx.fillStyle = '#090c10';
            ctx.fillRect(0, 0, W, H);

            const params = getInputParams();
            const maxDist = Math.max(params.trackLengthM, 203);
            const maxTime = Math.max(
                simulationResults.clutch.finishTime,
                simulationResults.quickshifter.finishTime,
                simulationResults.matic.finishTime,
                5.0
            );

            if (activeChartTab === 'dyno') {
                drawDynoCurveChart(ctx, W, H, padL, padR, padT, padB, plotW, plotH, params);
                return;
            }

            let maxY = 160;
            if (activeChartTab === 'speed_dist' || activeChartTab === 'speed_time') {
                maxY = Math.ceil(Math.max(
                    simulationResults.matic.topSpeedKmh,
                    simulationResults.clutch.topSpeedKmh,
                    120
                ) / 20) * 20;
            } else if (activeChartTab === 'rpm') {
                maxY = Math.ceil((Math.max(params.limitRpm, params.shiftRpm) + 1200) / 2000) * 2000;
            } else if (activeChartTab === 'force') {
                maxY = Math.ceil(Math.max(simulationResults.matic.peakWheelForceN, 1000) / 250) * 250;
            }

            // Y-axis Grid Lines
            ctx.strokeStyle = 'rgba(35, 44, 61, 0.8)';
            ctx.lineWidth = 1;
            ctx.font = '500 10px "JetBrains Mono", monospace';
            ctx.fillStyle = '#64748b';

            const ySteps = 5;
            for (let i = 0; i <= ySteps; i++) {
                const val = (maxY / ySteps) * i;
                const py = padT + plotH - (i / ySteps) * plotH;
                ctx.beginPath();
                ctx.moveTo(padL, py);
                ctx.lineTo(padL + plotW, py);
                ctx.stroke();

                ctx.textAlign = 'right';
                ctx.fillText(Math.round(val), padL - 8, py + 3);
            }

            // X-axis Grid Lines (Distance or Time)
            if (activeChartTab === 'speed_time') {
                const tSteps = 8;
                for (let i = 0; i <= tSteps; i++) {
                    const tVal = (maxTime / tSteps) * i;
                    const px = padL + (i / tSteps) * plotW;
                    ctx.beginPath();
                    ctx.moveTo(px, padT);
                    ctx.lineTo(px, padT + plotH);
                    ctx.stroke();

                    ctx.textAlign = 'center';
                    ctx.fillText(`${tVal.toFixed(1)}s`, px, padT + plotH + 18);
                }
            } else {
                const xCheckpoints = [0, 18.288, 50, 100, 150, 201, maxDist];
                xCheckpoints.forEach(d => {
                    if (d > maxDist) return;
                    const px = padL + (d / maxDist) * plotW;
                    ctx.beginPath();
                    ctx.moveTo(px, padT);
                    ctx.lineTo(px, padT + plotH);
                    ctx.stroke();

                    ctx.textAlign = 'center';
                    const lbl = d === 18.288 ? '60ft' : `${Math.round(d)}m`;
                    ctx.fillText(lbl, px, padT + plotH + 18);
                });
            }

            const modes = [
                { key: 'clutch', color: '#ef4444', label: `Kopling (${params.delayClutchMs}ms)` },
                { key: 'quickshifter', color: '#f59e0b', label: `Quickshifter (${params.delayQsMs}ms)` },
                { key: 'matic', color: '#10b981', label: `Matic (${params.delayMaticMs}ms)` }
            ];

            // Plot Curves
            if (activeChartTab === 'speed_dist' || activeChartTab === 'speed_time') {
                modes.forEach(m => {
                    const tele = simulationResults[m.key].telemetry;
                    ctx.strokeStyle = m.color;
                    ctx.lineWidth = activeTransMode === m.key ? 2.6 : 1.5;
                    ctx.beginPath();
                    tele.forEach((pt, idx) => {
                        const px = activeChartTab === 'speed_time'
                            ? padL + (pt.t / maxTime) * plotW
                            : padL + (pt.x / maxDist) * plotW;
                        const py = padT + plotH - (pt.vKmh / maxY) * plotH;
                        if (idx === 0) ctx.moveTo(px, py);
                        else ctx.lineTo(px, py);
                    });
                    ctx.stroke();
                });
                drawLegend(ctx, padL + 12, padT + 10, modes);
            } else if (activeChartTab === 'rpm') {
                // Draw Reference Horizontal Line for Shift RPM (Yellow) & Limit RPM (Red)
                const pyShift = padT + plotH - (params.shiftRpm / maxY) * plotH;
                const pyLimit = padT + plotH - (params.limitRpm / maxY) * plotH;

                ctx.save();
                ctx.setLineDash([6, 4]);
                ctx.strokeStyle = 'rgba(245, 158, 11, 0.7)';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.moveTo(padL, pyShift);
                ctx.lineTo(padL + plotW, pyShift);
                ctx.stroke();
                ctx.fillStyle = '#fbbf24';
                ctx.textAlign = 'right';
                ctx.fillText(`SHIFT RPM (${params.shiftRpm})`, padL + plotW - 6, pyShift - 4);

                ctx.strokeStyle = 'rgba(239, 68, 68, 0.85)';
                ctx.beginPath();
                ctx.moveTo(padL, pyLimit);
                ctx.lineTo(padL + plotW, pyLimit);
                ctx.stroke();
                ctx.fillStyle = '#f87171';
                ctx.fillText(`LIMIT RPM (${params.limitRpm})`, padL + plotW - 6, pyLimit - 4);
                ctx.restore();

                // Plot all 3 modes RPM curves (active mode bold)
                modes.forEach(m => {
                    const tele = simulationResults[m.key].telemetry;
                    ctx.strokeStyle = m.color;
                    ctx.lineWidth = activeTransMode === m.key ? 2.4 : 1.1;
                    ctx.globalAlpha = activeTransMode === m.key ? 1.0 : 0.45;
                    ctx.beginPath();
                    tele.forEach((pt, idx) => {
                        const px = padL + (pt.x / maxDist) * plotW;
                        const py = padT + plotH - (pt.rpm / maxY) * plotH;
                        if (idx === 0) ctx.moveTo(px, py);
                        else ctx.lineTo(px, py);
                    });
                    ctx.stroke();
                });
                ctx.globalAlpha = 1.0;
                drawLegend(ctx, padL + 12, padT + 10, modes);
            } else if (activeChartTab === 'force') {
                const activeTele = simulationResults[activeTransMode].telemetry;
                ctx.strokeStyle = '#06b6d4';
                ctx.lineWidth = 2;
                ctx.beginPath();
                activeTele.forEach((pt, idx) => {
                    const px = padL + (pt.x / maxDist) * plotW;
                    const py = padT + plotH - (pt.fDrive / maxY) * plotH;
                    if (idx === 0) ctx.moveTo(px, py);
                    else ctx.lineTo(px, py);
                });
                ctx.stroke();

                ctx.strokeStyle = '#ef4444';
                ctx.lineWidth = 2;
                ctx.beginPath();
                activeTele.forEach((pt, idx) => {
                    const px = padL + (pt.x / maxDist) * plotW;
                    const py = padT + plotH - (pt.fDragTotal / maxY) * plotH;
                    if (idx === 0) ctx.moveTo(px, py);
                    else ctx.lineTo(px, py);
                });
                ctx.stroke();

                drawLegend(ctx, padL + 12, padT + 10, [
                    { color: '#06b6d4', label: 'Gaya Dorong Roda (F_drive [N])' },
                    { color: '#ef4444', label: 'Hambatan Total (Angin + Ban + Slope [N])' }
                ]);
            }

            // Interactive Hover Crosshair
            if (chartHoverX !== null && chartHoverX >= padL && chartHoverX <= padL + plotW) {
                const fracX = (chartHoverX - padL) / plotW;
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
                ctx.lineWidth = 1;
                ctx.setLineDash([4, 4]);
                ctx.beginPath();
                ctx.moveTo(chartHoverX, padT);
                ctx.lineTo(chartHoverX, padT + plotH);
                ctx.stroke();
                ctx.setLineDash([]);

                const tele = simulationResults[activeTransMode].telemetry;
                let nearest = tele[0];
                if (activeChartTab === 'speed_time') {
                    const hoverT = fracX * maxTime;
                    for (let pt of tele) {
                        if (Math.abs(pt.t - hoverT) < Math.abs(nearest.t - hoverT)) nearest = pt;
                    }
                } else {
                    const hoverDist = fracX * maxDist;
                    for (let pt of tele) {
                        if (Math.abs(pt.x - hoverDist) < Math.abs(nearest.x - hoverDist)) nearest = pt;
                    }
                }

                const tipW = 205, tipH = 72;
                const tipX = Math.min(W - tipW - 15, chartHoverX + 12);
                const tipY = padT + 16;
                ctx.fillStyle = 'rgba(17, 22, 31, 0.95)';
                ctx.strokeStyle = '#f59e0b';
                ctx.lineWidth = 1;
                ctx.fillRect(tipX, tipY, tipW, tipH);
                ctx.strokeRect(tipX, tipY, tipW, tipH);

                ctx.fillStyle = '#f8fafc';
                ctx.textAlign = 'left';
                ctx.font = '700 10px "JetBrains Mono", monospace';
                ctx.fillText(`Jarak: ${nearest.x.toFixed(1)}m | t: ${nearest.t.toFixed(3)}s`, tipX + 8, tipY + 16);
                ctx.fillStyle = '#38bdf8';
                ctx.fillText(`Speed: ${nearest.vKmh.toFixed(1)} km/h (Gigi ${nearest.gear})`, tipX + 8, tipY + 34);
                ctx.fillStyle = nearest.isLimiterCut ? '#f87171' : '#f59e0b';
                ctx.fillText(`RPM  : ${Math.round(nearest.rpm)} ${nearest.isLimiterCut ? '[LIMIT!]' : ''}`, tipX + 8, tipY + 52);
            }
        }

        function drawDynoCurveChart(ctx, W, H, padL, padR, padT, padB, plotW, plotH, params) {
            const minRpm = 4000;
            const maxRpm = Math.max(params.limitRpm + 1000, params.shiftRpm + 1000, 15000);
            const maxHpScale = Math.ceil((params.hp * 1.25) / 10) * 10;

            ctx.strokeStyle = 'rgba(35, 44, 61, 0.8)';
            ctx.lineWidth = 1;
            ctx.font = '500 10px "JetBrains Mono", monospace';
            ctx.fillStyle = '#64748b';

            for (let i = 0; i <= 5; i++) {
                const val = (maxHpScale / 5) * i;
                const py = padT + plotH - (i / 5) * plotH;
                ctx.beginPath();
                ctx.moveTo(padL, py);
                ctx.lineTo(padL + plotW, py);
                ctx.stroke();
                ctx.textAlign = 'right';
                ctx.fillText(`${Math.round(val)}`, padL - 8, py + 3);
            }

            const rpmSteps = 6;
            for (let i = 0; i <= rpmSteps; i++) {
                const r = minRpm + ((maxRpm - minRpm) / rpmSteps) * i;
                const px = padL + (i / rpmSteps) * plotW;
                ctx.beginPath();
                ctx.moveTo(px, padT);
                ctx.lineTo(px, padT + plotH);
                ctx.stroke();
                ctx.textAlign = 'center';
                ctx.fillText(`${Math.round(r)}`, px, padT + plotH + 18);
            }

            // Draw Vertical Markers for Peak RPM, Shift RPM, and Limit RPM
            const markers = [
                { rpm: params.peakRpm, label: 'PEAK HP', color: '#38bdf8' },
                { rpm: params.shiftRpm, label: 'SHIFT RPM', color: '#f59e0b' },
                { rpm: params.limitRpm, label: 'LIMIT RPM', color: '#ef4444' }
            ];
            markers.forEach(m => {
                if (m.rpm >= minRpm && m.rpm <= maxRpm) {
                    const mx = padL + ((m.rpm - minRpm) / (maxRpm - minRpm)) * plotW;
                    ctx.save();
                    ctx.setLineDash([5, 4]);
                    ctx.strokeStyle = m.color;
                    ctx.beginPath();
                    ctx.moveTo(mx, padT);
                    ctx.lineTo(mx, padT + plotH);
                    ctx.stroke();
                    ctx.fillStyle = m.color;
                    ctx.textAlign = 'center';
                    ctx.fillText(m.label, mx, padT + 12);
                    ctx.restore();
                }
            });

            // Plot Horsepower Curve up to Limit RPM
            ctx.strokeStyle = '#f59e0b';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            for (let r = minRpm; r <= params.limitRpm; r += 100) {
                const eng = calculateEnginePowerAndTorque(r, params);
                const px = padL + ((r - minRpm) / (maxRpm - minRpm)) * plotW;
                const py = padT + plotH - (eng.hp / maxHpScale) * plotH;
                if (r === minRpm) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            }
            ctx.stroke();

            // Plot Torque Curve (Nm) up to Limit RPM
            ctx.strokeStyle = '#10b981';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            for (let r = minRpm; r <= params.limitRpm; r += 100) {
                const eng = calculateEnginePowerAndTorque(r, params);
                const px = padL + ((r - minRpm) / (maxRpm - minRpm)) * plotW;
                const py = padT + plotH - (eng.torqueNm / maxHpScale) * plotH;
                if (r === minRpm) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            }
            ctx.stroke();

            drawLegend(ctx, padL + 12, padT + 22, [
                { color: '#f59e0b', label: `Kurva Tenaga (Peak ${params.hp.toFixed(1)} HP @ ${params.peakRpm} RPM)` },
                { color: '#10b981', label: `Kurva Torsi Mesin (Nm) — Cut @ Limit ${params.limitRpm} RPM` }
            ]);
        }

        function drawLegend(ctx, x, y, items) {
            items.forEach((it, idx) => {
                const ly = y + idx * 18;
                ctx.fillStyle = it.color;
                ctx.fillRect(x, ly, 12, 3);
                ctx.fillStyle = '#e2e8f0';
                ctx.font = '600 10px "JetBrains Mono", monospace';
                ctx.textAlign = 'left';
                ctx.fillText(it.label, x + 18, ly + 4);
            });
        }

