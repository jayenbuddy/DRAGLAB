<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PV PROJECT PERFORMANCE LAB — 203m Drag Race Physics & Telemetry Simulator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Chakra Petch, Exo 2 & JetBrains Mono for Authentic PV Project Motorsport Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,500;0,600;0,700;1,600;1,700&family=Exo+2:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700;1,800;1,900&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Exo 2"', 'sans-serif'],
                        display: ['"Chakra Petch"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                    colors: {
                        telemetry: {
                            bg: '#04080a',
                            panel: '#071014',
                            card: '#0a161c',
                            border: '#12353c',
                            accent: '#00d8c8',
                            tealDark: '#12948a',
                            red: '#ff3b5c',
                            green: '#10b981',
                            cyan: '#00f0dc',
                            gold: '#eab308'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --pv-cyan: #00d8c8;
            --pv-cyan-bright: #00f0dc;
            --pv-teal-deep: #159b90;
            --pv-obsidian: #04080a;
            --pv-panel: #071014;
            --pv-card: #09151b;
        }
        body {
            background-color: #04080a;
            background-image:
                radial-gradient(ellipse 65% 45% at 22% 10%, rgba(0, 216, 200, 0.13) 0%, transparent 70%),
                radial-gradient(ellipse 60% 50% at 85% 85%, rgba(21, 155, 144, 0.12) 0%, transparent 70%),
                linear-gradient(180deg, #04080a 0%, #060e12 55%, #030608 100%);
            color: #eef6f7;
            font-family: 'Exo 2', sans-serif;
            overflow-x: hidden;
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #04080a;
        }
        ::-webkit-scrollbar-thumb {
            background: #123c42;
            border-radius: 2px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00d8c8;
        }
        .telemetry-grid-bg {
            background-image: 
                linear-gradient(to right, rgba(0, 216, 200, 0.045) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0, 216, 200, 0.045) 1px, transparent 1px);
            background-size: 28px 28px;
        }
        /* Background decorative diagonal stripes matching bottom-right of reference poster */
        .pv-bg-stripes {
            position: fixed;
            right: -80px;
            bottom: -40px;
            width: 520px;
            height: 420px;
            pointer-events: none;
            z-index: 0;
            opacity: 0.16;
            background: repeating-linear-gradient(
                -42deg,
                rgba(0, 216, 200, 0.45) 0px,
                rgba(0, 216, 200, 0.45) 36px,
                transparent 36px,
                transparent 68px
            );
            mask-image: radial-gradient(circle at bottom right, black 20%, transparent 75%);
            -webkit-mask-image: radial-gradient(circle at bottom right, black 20%, transparent 75%);
        }
        /* PV Project Poster Box Architecture (Matching Box A & Box B) */
        .pv-poster-panel {
            position: relative;
            background: linear-gradient(165deg, rgba(9, 22, 28, 0.95) 0%, rgba(5, 11, 15, 0.98) 100%);
            border: 1px solid rgba(0, 216, 200, 0.42);
            box-shadow: 0 14px 34px -10px rgba(0, 0, 0, 0.85), 0 0 22px rgba(0, 216, 200, 0.05);
            clip-path: polygon(0 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%);
        }
        .pv-poster-panel::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 68%;
            height: 4px;
            background: linear-gradient(90deg, #00d8c8 0%, #159b90 88%, transparent 100%);
            pointer-events: none;
        }
        /* Banner Header matching "A | HARIAN TOURING / Rp 800.000" */
        .pv-banner-header {
            position: relative;
            display: flex;
            align-items: stretch;
            background: linear-gradient(90deg, rgba(7, 19, 25, 0.98) 0%, rgba(11, 29, 36, 0.92) 100%);
            border: 1.5px solid #00d8c8;
            box-shadow: 0 0 16px rgba(0, 216, 200, 0.14);
            overflow: hidden;
        }
        .pv-banner-badge {
            background: linear-gradient(135deg, #00f0dc 0%, #00b8aa 100%);
            color: #03090b;
            font-family: 'Exo 2', sans-serif;
            font-style: italic;
            font-weight: 900;
            font-size: 1.35rem;
            line-height: 1;
            min-width: 48px;
            padding: 0 16px 0 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
            margin-right: -6px;
            z-index: 2;
        }
        /* Slanted cyan parallelogram bullet matching poster list items */
        .pv-bullet {
            display: inline-block;
            width: 8px;
            height: 11px;
            background: #00d8c8;
            transform: skewX(-22deg);
            margin-right: 6px;
            flex-shrink: 0;
            box-shadow: 0 0 6px rgba(0, 216, 200, 0.45);
        }
        .pv-slash-bars {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-left: 8px;
        }
        .pv-slash-bars span {
            display: inline-block;
            width: 9px;
            height: 22px;
            background: #00d8c8;
            transform: skewX(-24deg);
        }
        .pv-slash-bars span:last-child {
            background: #159b90;
            width: 12px;
        }
        /* Bottom corner hatch stripes */
        .pv-bottom-hatches {
            display: inline-flex;
            gap: 3px;
            position: absolute;
            bottom: 0;
            left: 69%;
            height: 5px;
        }
        .pv-bottom-hatches i {
            display: block;
            width: 7px;
            height: 4px;
            background: #00d8c8;
            transform: skewX(-32deg);
            opacity: 0.75;
        }
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            opacity: 1;
        }
        .shift-flash {
            animation: flashRed 0.14s infinite alternate;
        }
        @keyframes flashRed {
            from { background-color: rgba(255, 59, 92, 0.2); border-color: #ff3b5c; }
            to { background-color: rgba(255, 59, 92, 0.85); border-color: #fda4af; }
        }
    </style>
</head>
<body class="min-h-screen telemetry-grid-bg selection:bg-[#00d8c8] selection:text-black relative">

    <!-- Ambient Diagonal Stripes from Reference Poster -->
    <div class="pv-bg-stripes"></div>

    <!-- Top Navigation / PV PROJECT PERFORMANCE LAB Reference Header -->
    <header class="sticky top-0 z-40 bg-[#04080a]/95 backdrop-blur-md border-b border-[#00d8c8]/35 shadow-[0_6px_28px_rgba(0,0,0,0.85)]">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-6 py-3 grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] items-center gap-4">
            
            <!-- Left + Center: Official PV PROJECT Logo + Vertical Divider + NINJA 2T Style Headline -->
            <div class="flex flex-wrap items-center gap-4 sm:gap-6">
                

                <!-- Vertical Crisp White Divider matching Reference Poster -->
                <div class="hidden sm:block h-12 w-[2px] bg-white/80 rounded-full"></div>

                <!-- Center Poster Title Block: "SIMULASI TELEMETRI / DRAG PHYSICS 203M // / PV PROJECT 1000HZ" -->
                <div>
                    <div class="flex items-center gap-2.5">
                        <span class="text-[11px] sm:text-xs font-display font-semibold italic tracking-[0.22em] text-white/90 uppercase">SIMULASI TELEMETRI</span>
                        <span class="px-2 py-0.5 text-[10px] font-mono font-bold uppercase tracking-wider bg-[#00d8c8]/15 text-[#00f0dc] border border-[#00d8c8]/40">1000Hz / dt=1ms</span>
                        <span id="headerSensorBadge" class="hidden md:inline-block px-2 py-0.5 text-[10px] font-mono font-bold uppercase tracking-wider bg-[#00d8c8]/10 text-[#00d8c8] border border-[#00d8c8]/30">Sensor Lampu (28cm Rollout)</span>
                    </div>
                    <div class="flex items-center">
                        <h1 class="text-xl sm:text-3xl font-black italic tracking-wider text-white uppercase leading-none mt-0.5">
                            DRAG PHYSICS <span class="text-[#00d8c8]">203M</span>
                        </h1>
                        <div class="pv-slash-bars" aria-hidden="true">
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                    <p class="text-[11px] sm:text-xs font-display font-bold italic tracking-[0.18em] text-slate-200 uppercase mt-1">
                        PV PROJECT 149 / PRO DYNO &amp; RATIO LAB
                    </p>
                </div>
            </div>

                <div class="flex flex-col items-center justify-self-center select-none group">
                <!-- PV PROJECT logo (new) - embedded PNG, transparent background -->
                <img src="data:image/png;base64," alt="PV Project Performance Lab Logo" class="h-16 sm:h-20 w-auto select-none drop-shadow-[0_2px_12px_rgba(0,216,200,0.22)]" draggable="false">
                </div>

            <!-- Right Controls & Poster Tagline ("TUNE UP FOR BETTER PERFORMANCE") -->
            <div class="flex flex-wrap items-center justify-end gap-3 sm:gap-5 ml-auto">
                <!-- Telemetry Status Pills -->
                <div class="flex flex-wrap items-center gap-2">
                    <div class="bg-[#071318] border border-[#00d8c8]/40 px-3 py-1.5 flex items-center gap-2">
                        <span class="text-[10px] font-mono uppercase text-slate-400">PWR/WEIGHT:</span>
                        <span id="headerPwrWeight" class="text-xs font-mono font-bold text-[#00f0dc]">165.0 HP/Ton</span>
                    </div>
                    <div class="bg-[#071318] border border-[#00d8c8]/40 px-3 py-1.5 flex items-center gap-2">
                        <span class="text-[10px] font-mono uppercase text-slate-400">SHIFT / LIMIT:</span>
                        <span id="headerRpmSummary" class="text-xs font-mono font-bold text-white">12800 / 13800 RPM</span>
                    </div>
                    <button id="btnResetDefaults" class="px-3 py-1.5 bg-[#09181f] hover:bg-[#0f2731] text-slate-200 border border-[#00d8c8]/40 text-xs font-display font-bold italic uppercase tracking-wider transition flex items-center gap-1.5">
                        <i class="fa-solid fa-rotate-left text-[#00d8c8]"></i> Reset
                    </button>
                    <button id="btnCopyReport" class="px-3.5 py-1.5 bg-[#00d8c8] hover:bg-[#00f0dc] text-[#03080a] font-display font-black italic uppercase tracking-wider text-xs transition flex items-center gap-1.5 shadow-[0_0_18px_rgba(0,216,200,0.35)]">
                        <i class="fa-solid fa-copy"></i> Salin Slip
                    </button>
                </div>

                <!-- Reference Poster Right Tagline: "TUNE UP FOR BETTER PERFORMANCE" -->
                <div class="hidden xl:flex flex-col items-start border-l border-white/20 pl-4 leading-tight select-none">
                    <span class="text-[11px] font-display font-semibold italic tracking-[0.18em] text-white uppercase">TUNE UP</span>
                    <span class="text-[11px] font-display font-semibold italic tracking-[0.18em] text-white uppercase">FOR BETTER</span>
                    <span class="text-xs font-display font-extrabold italic tracking-[0.18em] text-[#00d8c8] uppercase">PERFORMANCE</span>
                    <span class="w-8 h-[2.5px] bg-[#00d8c8] mt-1"></span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 py-5 space-y-5">

        <!-- PRESET SELECTOR BAR (PV PROJECT TELEMETRY PROFILE BAR) -->
        <div class="pv-poster-panel p-3.5 sm:p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-[#00d8c8]/15 border border-[#00d8c8] flex items-center justify-center text-[#00f0dc] transform -skew-x-12">
                    <i class="fa-solid fa-sliders text-sm transform skew-x-12"></i>
                </div>
                <div>
                    <h2 class="text-xs sm:text-sm font-display font-extrabold italic uppercase tracking-wider text-white flex items-center gap-2">
                        PROFIL SETUP CEPAT <span class="text-[#00d8c8]">// PV PROJECT LAB</span>
                    </h2>
                    <p class="text-[11px] text-slate-300">Pilih paket kalibrasi mesin &amp; lintasan atau sesuaikan setiap parameter secara langsung di bawah.</p>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 w-full md:w-auto">
                <button type="button" id="btnPreset1" class="preset-btn active-preset px-3.5 py-2 border-2 border-[#00d8c8] bg-[#00d8c8]/15 text-left transition">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-display font-extrabold italic uppercase text-[#00f0dc]">PAKET A: DRAG 33 HP</span>
                        <span class="text-[10px] font-mono bg-[#00d8c8] text-black font-extrabold px-1.5 py-0.5">60ft ~1.80s</span>
                    </div>
                    <div class="text-[10px] font-mono text-slate-200 mt-0.5">200kg | Shift 12.8k / Limit 13.8k RPM</div>
                </button>
                <button type="button" id="btnPreset2" class="preset-btn px-3.5 py-2 border border-[#00d8c8]/35 bg-[#09151b] hover:border-[#00d8c8] text-left transition">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-display font-extrabold italic uppercase text-white">PAKET B: STANDAR 30 HP</span>
                        <span class="text-[10px] font-mono bg-[#050c10] text-[#00d8c8] border border-[#00d8c8]/40 font-bold px-1.5 py-0.5">Base Spec</span>
                    </div>
                    <div class="text-[10px] font-mono text-slate-400 mt-0.5">200kg | Primer 22/70 | Final 13/41</div>
                </button>
                <button type="button" id="btnPreset3" class="preset-btn px-3.5 py-2 border border-[#00d8c8]/35 bg-[#09151b] hover:border-[#00d8c8] text-left transition">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-display font-extrabold italic uppercase text-white">PAKET C: KOMPETISI 38 HP</span>
                        <span class="text-[10px] font-mono bg-[#050c10] text-[#00f0dc] border border-[#00d8c8]/40 font-bold px-1.5 py-0.5">185 kg</span>
                    </div>
                    <div class="text-[10px] font-mono text-slate-400 mt-0.5">Primer 22/72 | Shift 13.2k / Limit 14.2k</div>
                </button>
            </div>
            <div class="pv-bottom-hatches"><i></i><i></i><i></i><i></i></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- LEFT COLUMN: INPUT PARAMETERS STYLED AS POSTER BOXES A, B, C, D -->
            <section class="lg:col-span-4 space-y-5">

                <!-- BOX A: Transmission Shift Delay Selector -->
                <div class="pv-poster-panel p-4 sm:p-5">
                    <!-- Poster Banner Header "A | SISTEM TRANSMISI / 70 ms" -->
                    <div class="pv-banner-header mb-3.5">
                        <div class="pv-banner-badge">A</div>
                        <div class="flex-1 flex items-center justify-between px-3 py-2">
                            <span class="text-xs sm:text-sm font-display font-extrabold italic uppercase tracking-wider text-white">SISTEM TRANSMISI &amp; JEDA</span>
                            <div class="flex items-center gap-2">
                                <span class="text-[#00d8c8] font-bold">/</span>
                                <span class="text-xs sm:text-sm font-mono font-extrabold text-[#00f0dc]" id="activeShiftDelayBadge">70 ms</span>
                            </div>
                        </div>
                    </div>

                    <p class="text-xs text-slate-300 mb-3 flex items-start">
                        <span class="pv-bullet mt-1"></span>
                        <span>Selama jeda perpindahan gigi, aliran torsi terputus (<span class="font-mono text-[#00f0dc]">F_drive = 0 N</span>) dan motor mengalami deselerasi nyata.</span>
                    </p>

                    <div class="grid grid-cols-3 gap-2.5 mb-3">
                        <button type="button" data-mode="clutch" class="trans-mode-btn group relative flex flex-col items-center justify-center p-3 border border-[#00d8c8]/30 bg-[#09151b] hover:border-[#ff3b5c] transition text-center">
                            <span class="w-2.5 h-2.5 bg-[#ff3b5c] transform -skew-x-12 mb-1.5"></span>
                            <span class="text-xs font-display font-bold italic uppercase text-white">Kopling</span>
                            <span class="text-[11px] font-mono text-[#ff3b5c] font-bold" id="lblClutchMs">200 ms</span>
                            <span class="text-[10px] text-slate-400 mt-0.5">Manual</span>
                        </button>
                        <button type="button" data-mode="quickshifter" class="trans-mode-btn active-mode group relative flex flex-col items-center justify-center p-3 border-2 border-[#00d8c8] bg-[#00d8c8]/15 transition text-center">
                            <span class="w-2.5 h-2.5 bg-[#00f0dc] transform -skew-x-12 mb-1.5"></span>
                            <span class="text-xs font-display font-bold italic uppercase text-white">Quickshifter</span>
                            <span class="text-[11px] font-mono text-[#00f0dc] font-bold" id="lblQsMs">70 ms</span>
                            <span class="text-[10px] text-slate-300 mt-0.5">ECU Cut</span>
                        </button>
                        <button type="button" data-mode="matic" class="trans-mode-btn group relative flex flex-col items-center justify-center p-3 border border-[#00d8c8]/30 bg-[#09151b] hover:border-amber-400 transition text-center">
                            <span class="w-2.5 h-2.5 bg-amber-400 transform -skew-x-12 mb-1.5"></span>
                            <span class="text-xs font-display font-bold italic uppercase text-white">Sistem Matic</span>
                            <span class="text-[11px] font-mono text-amber-400 font-bold" id="lblMaticMs">50 ms</span>
                            <span class="text-[10px] text-slate-400 mt-0.5">Seamless</span>
                        </button>
                    </div>

                    <!-- Custom Shift Times Input -->
                    <div class="grid grid-cols-3 gap-2 pt-2.5 border-t border-[#00d8c8]/25">
                        <div>
                            <label class="block text-[10px] font-mono text-slate-300 mb-1">Jeda Kopling (ms)</label>
                            <input type="number" id="inpDelayClutch" value="200" min="0" max="1000" step="5" class="sim-input w-full bg-[#04080a] border border-[#00d8c8]/40 px-2.5 py-1.5 text-xs font-mono text-[#ff3b5c] font-bold focus:outline-none focus:border-[#00f0dc]">
                        </div>
                        <div>
                            <label class="block text-[10px] font-mono text-slate-300 mb-1">Jeda QS (ms)</label>
                            <input type="number" id="inpDelayQs" value="70" min="0" max="1000" step="5" class="sim-input w-full bg-[#04080a] border border-[#00d8c8]/40 px-2.5 py-1.5 text-xs font-mono text-[#00f0dc] font-bold focus:outline-none focus:border-[#00f0dc]">
                        </div>
                        <div>
                            <label class="block text-[10px] font-mono text-slate-300 mb-1">Jeda Matic (ms)</label>
                            <input type="number" id="inpDelayMatic" value="50" min="0" max="1000" step="5" class="sim-input w-full bg-[#04080a] border border-[#00d8c8]/40 px-2.5 py-1.5 text-xs font-mono text-amber-400 font-bold focus:outline-none focus:border-[#00f0dc]">
                        </div>
                    </div>
                    <div class="pv-bottom-hatches"><i></i><i></i><i></i><i></i></div>
                </div>

                <!-- BOX B: Engine, Separate Shift RPM vs Limit RPM, Mass & Wheel -->
                <div class="pv-poster-panel p-4 sm:p-5 space-y-4">
                    <div class="pv-banner-header">
                        <div class="pv-banner-badge">B</div>
                        <div class="flex-1 flex items-center justify-between px-3 py-2">
                            <span class="text-xs sm:text-sm font-display font-extrabold italic uppercase tracking-wider text-white">MESIN, RPM &amp; BOBOT</span>
                            <div class="flex items-center gap-1.5">
                                <span class="text-[#00d8c8] font-bold">/</span>
                                <span class="text-xs font-mono font-extrabold text-[#00f0dc]" id="lblTotalMass">200.0 kg</span>
                            </div>
                        </div>
                    </div>

                    <!-- Horsepower & Power Mode -->
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="flex items-center text-xs text-slate-200 font-semibold mb-1"><span class="pv-bullet"></span>Horsepower (HP)</label>
                            <div class="relative">
                                <input type="number" id="inpHp" value="33" min="5" max="500" step="0.5" class="sim-input w-full bg-[#04080a] border border-[#00d8c8]/50 pl-3 pr-10 py-2 text-sm font-mono font-extrabold text-[#00f0dc] focus:outline-none focus:border-[#00f0dc]">
                                <span class="absolute right-3 top-2 text-xs font-mono text-slate-400">HP</span>
                            </div>
                        </div>
                        <div>
                            <label class="flex items-center text-xs text-slate-200 font-semibold mb-1"><span class="pv-bullet"></span>Efisiensi Rantai</label>
                            <select id="inpHpType" class="sim-input w-full bg-[#04080a] border border-[#00d8c8]/50 px-2.5 py-2 text-xs font-mono text-white focus:outline-none focus:border-[#00f0dc]">
                                <option value="1.00">Wheel HP Murni (100%)</option>
                                <option value="0.95" selected>Drag Chain Spec (&eta; = 95%)</option>
                                <option value="0.92">On-Crank Dyno (&eta; = 92%)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Engine RPM Characteristics (SEPARATED SHIFT RPM & LIMIT RPM) -->
                    <div class="bg-[#061116] border border-[#00d8c8]/35 p-3 space-y-3">
                        <div class="flex items-center justify-between border-b border-[#00d8c8]/20 pb-1.5">
                            <span class="text-[11px] font-display font-bold italic uppercase tracking-wider text-[#00f0dc] flex items-center"><span class="pv-bullet"></span>KONFIGURASI PUTARAN MESIN (RPM)</span>
                            <span class="text-[10px] font-mono text-slate-400">Shift vs Limiter</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2.5">
