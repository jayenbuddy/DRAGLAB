                chartHoverX = null;
                drawTelemetryChart();
            });

            // Reset & Copy Buttons
            document.getElementById('btnResetDefaults').addEventListener('click', () => {
                highlightPresetBtn('btnPreset1');
                applyPresetConfig('preset1');
            });
            document.getElementById('btnCopyReport').addEventListener('click', copyTimeSlipToClipboard);
            document.getElementById('btnCopyTextBox').addEventListener('click', copyTimeSlipToClipboard);

            // Responsive Resize Handler
            window.addEventListener('resize', () => {
                updateDashboardAndTrackAtTime(animState.currentTime);
                drawTelemetryChart();
            });

            // Initial Simulation Run with Preset 1
            applyPresetConfig('preset1');
        };
    </script>
</body>
</html>
