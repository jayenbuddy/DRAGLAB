        /**
         * Realistic Engine Power & Torque Curve Function
         * Peak Power = P_max at peakRpm. Above peakRpm toward Limit RPM, volumetric efficiency tapers gently.
         */
        function calculateEnginePowerAndTorque(rpm, params) {
            const safeRpm = Math.max(1500, rpm);
            const x = safeRpm / params.peakRpm;
            let normPower;

            if (x <= 1.0) {
                normPower = x * (0.35 + 1.30 * x - 0.65 * x * x);
            } else {
                const overRev = x - 1.0;
                normPower = Math.max(0.25, 1.0 - 1.20 * overRev * overRev);
            }

            const currentHp = params.hp * Math.max(0.1, normPower);
            const powerWatts = currentHp * 745.699872;
            const torqueNm = (powerWatts * 60) / (2 * Math.PI * safeRpm);

            return {
                hp: currentHp,
                powerWatts: powerWatts,
                torqueNm: torqueNm
            };
        }

        /**
         * Runs the 1ms (1000 Hz) time-step numerical integration with separate Shift RPM vs Limit RPM
         * and Stage Rollout calibration.
         */
        function simulateDragRun(params, shiftDelayMs, modeKey) {
            const dt = 0.001; // 1 millisecond (1000 Hz)
            const g = 9.80665;
            const rho = 1.2041;

            const totalMass = params.bikeMass + params.riderMass;
            const wheelRadius = (params.wheelDiaMm / 1000) / 2;
            const wheelCircumference = 2 * Math.PI * wheelRadius;

            const primaryRatio = params.primDriven / params.primDrive;
            const finalRatio = params.rearSprocket / params.frontSprocket;
            const baseReduction = primaryRatio * finalRatio;

            // Calculate total ratio, Speed @ Shift RPM, and Max Speed @ Limit RPM for each of the 6 gears
            const gearData = params.gears.map((gObj, idx) => {
                const gearRatio = gObj.driven / gObj.drive;
                const totalRatio = baseReduction * gearRatio;
                const speedAtShiftMps = (params.shiftRpm / 60 / totalRatio) * wheelCircumference;
                const speedAtLimitMps = (params.limitRpm / 60 / totalRatio) * wheelCircumference;
                return {
                    gearNumber: idx + 1,
                    drive: gObj.drive,
                    driven: gObj.driven,
                    gearRatio: gearRatio,
                    totalRatio: totalRatio,
                    speedAtShiftKmh: speedAtShiftMps * 3.6,
                    speedAtLimitKmh: speedAtLimitMps * 3.6
                };
            });

            const windSpeedMps = params.windSpeedKmh / 3.6;
            const shiftDelaySec = shiftDelayMs / 1000;
            const finishTargetDist = Math.max(params.trackLengthM, 203);
            const rolloutM = params.rolloutM; // 0.28m for Drag Strip Stage Beam, 0.0m for True Zero

            const targetDistances = [18.288, 100.0, 150.0, 201.0, params.trackLengthM];
            const recordedCheckpoints = {};

            // State Variables
            let rawTime = 0.0;          // Time since initial clutch release at xRaw = 0
            let rolloutCrossTime = (rolloutM <= 0) ? 0.0 : null;
            let xRaw = 0.0;             // Raw distance from stage beam center
            let xOfficial = -rolloutM;  // Official timed distance (0.000m when beam clears)
            let v = 0.0;
            let a = 0.0;
            let currentGearIdx = 0;     // 0 = Gear 1
            let shiftTimer = 0.0;
            let limiterBounceTimer = 0.0;
            let isShifting = false;
            let isLimiterCut = false;
            let hitLimiterInGear6 = false;
            let hitLimiterBeforeShift = false;
            let zeroToHundredTime = null;
            let topSpeedKmh = 0;
            let rpm = params.launchRpm;

            let peakTorqueNm = 0;
            let peakWheelForceN = 0;

            const telemetry = [];
            const maxSimTime = 35.0;

            while (xOfficial < finishTargetDist && rawTime < maxSimTime) {
                const prevXOfficial = xOfficial;
                const prevXRaw = xRaw;
                const prevV = v;
                const prevRawTime = rawTime;
                const prevOfficialTime = rolloutCrossTime !== null ? (rawTime - rolloutCrossTime) : 0.0;

                const activeGear = gearData[currentGearIdx];
                const iTotal = activeGear.totalRatio;

                // Coupled engine RPM from rear wheel angular velocity
                const wheelRadPerSec = v / wheelRadius;
                const coupledRpm = (wheelRadPerSec * iTotal * 60) / (2 * Math.PI);

                let fDrive = 0;
                let currentTorque = 0;

                // 1. Check if currently in Gear Shift interruption window
                if (shiftTimer > 0) {
                    isShifting = true;
                    isLimiterCut = false;
                    fDrive = 0;
                    rpm = Math.max(params.launchRpm * 0.7, coupledRpm);
                    shiftTimer -= dt;
                    if (shiftTimer <= 0) {
                        shiftTimer = 0;
                        isShifting = false;
                    }
                } else {
                    isShifting = false;

                    // 2. Check Shift RPM & Limit RPM rules on Gears 1 to 5
                    if (currentGearIdx < gearData.length - 1) {
                        // If user sets Shift RPM > Limit RPM, the engine hits Limit RPM first and bounces briefly before shifting
                        if (params.shiftRpm > params.limitRpm && coupledRpm >= params.limitRpm) {
                            hitLimiterBeforeShift = true;
                            if (limiterBounceTimer <= 0 && !isLimiterCut) {
                                limiterBounceTimer = 0.035; // 35ms rev limiter cut bounce penalty
                                isLimiterCut = true;
                            }
                        }

                        if (limiterBounceTimer > 0) {
                            limiterBounceTimer -= dt;
                            fDrive = 0;
                            rpm = params.limitRpm;
                            if (limiterBounceTimer <= 0) {
                                // Force shift after limiter bounce
                                isLimiterCut = false;
                                currentGearIdx++;
                                if (shiftDelaySec > 0) {
                                    shiftTimer = shiftDelaySec;
                                    isShifting = true;
                                    fDrive = 0;
                                }
                            }
                        } else if (coupledRpm >= params.shiftRpm) {
                            // Normal upshift triggered at Shift RPM
                            currentGearIdx++;
                            if (shiftDelaySec > 0) {
                                shiftTimer = shiftDelaySec;
                                isShifting = true;
                                fDrive = 0;
                            }
                        }
                    }

                    // 3. Calculate Engine Drive Force when not shifting or bouncing
                    if (!isShifting && limiterBounceTimer <= 0) {
                        let effectiveRpm = coupledRpm;
                        if (currentGearIdx === 0 && coupledRpm < params.launchRpm) {
                            effectiveRpm = params.launchRpm;
                        } else {
                            effectiveRpm = Math.max(2500, coupledRpm);
                        }

                        // Check Rev Limiter (Limit RPM) in Gear 6 (or any gear)
                        if (effectiveRpm >= params.limitRpm) {
                            isLimiterCut = true;
                            if (currentGearIdx === gearData.length - 1) {
                                hitLimiterInGear6 = true;
                            }
                            fDrive = 0;
                            rpm = params.limitRpm;
                        } else {
                            isLimiterCut = false;
                            rpm = effectiveRpm;
                            const eng = calculateEnginePowerAndTorque(rpm, params);
                            currentTorque = eng.torqueNm;
                            if (currentTorque > peakTorqueNm) peakTorqueNm = currentTorque;

                            // Flywheel & Clutch Slip Kinetic Impulse during initial launch (first 14 meters)
                            let launchImpulseMult = 1.0;
                            if (currentGearIdx === 0 && xRaw < 14.0 && params.flywheelImpulsePct > 0) {
                                const decay = Math.max(0, 1.0 - (xRaw / 14.0));
                                launchImpulseMult = 1.0 + 0.28 * (params.flywheelImpulsePct / 100) * decay;
                            }

                            const rawForce = (currentTorque * launchImpulseMult * iTotal * params.hpEfficiency) / wheelRadius;

                            // Tire longitudinal traction limit (Launch Grip G-Force)
                            // Dynamic weight transfer boost in first 20m, tapering slightly at high speed
                            const dynamicGripMu = xRaw < 22.0
                                ? params.tireMu
                                : Math.max(0.85, params.tireMu * 0.92);
                            const maxTireForce = dynamicGripMu * totalMass * g;

                            fDrive = Math.min(rawForce, maxTireForce);
                            if (fDrive > peakWheelForceN) peakWheelForceN = fDrive;
                        }
                    }
                }

                // Aerodynamic Drag Force: F_aero = 0.5 * rho * CdA * (v + v_wind)^2
                const vRel = v + windSpeedMps;
                const fAero = 0.5 * rho * params.cdA * (vRel * Math.abs(vRel));

                // Rolling Resistance Force: F_roll = Crr * m * g
                const fRoll = (v > 0.001 || fDrive > 0) ? (params.crr * totalMass * g) : 0;

                // Track Slope Gravity Component: F_slope = m * g * (slope% / 100)
                const fSlope = (v > 0.001 || fDrive > 0) ? (totalMass * g * (params.trackSlopePct / 100)) : 0;

                // Equivalent Rotational Mass Factor (wheels + crank/clutch inertia)
                // Lightweight racing rotor/crank inertia factor
                const wheelInertiaFactor = 0.032;
                const engineInertiaCoeff = 0.000095;
                const rotationalMassFactor = isShifting
                    ? (1.0 + wheelInertiaFactor)
                    : (1.0 + wheelInertiaFactor + engineInertiaCoeff * (iTotal * iTotal));

                const effectiveMass = totalMass * rotationalMassFactor;

                // Net Longitudinal Acceleration (m/s^2)
                a = (fDrive - fAero - fRoll - fSlope) / effectiveMass;
                if (v <= 0 && a < 0) a = 0;

                // Kinematics step
                v = Math.max(0, v + a * dt);
                const avgV = 0.5 * (prevV + v);
                xRaw = prevXRaw + avgV * dt;
                xOfficial = xRaw - rolloutM;
                rawTime = prevRawTime + dt;

                const currentSpeedKmh = v * 3.6;
                if (currentSpeedKmh > topSpeedKmh) topSpeedKmh = currentSpeedKmh;

                // Detect Stage Rollout beam crossing (xOfficial transitions from < 0 to >= 0)
                if (rolloutCrossTime === null && prevXOfficial < 0 && xOfficial >= 0) {
                    const fracRoll = (0 - prevXOfficial) / Math.max(1e-9, (xOfficial - prevXOfficial));
                    rolloutCrossTime = prevRawTime + fracRoll * dt;
                }

                const currentOfficialTime = rolloutCrossTime !== null ? Math.max(0, rawTime - rolloutCrossTime) : 0.0;

                // Detect 0 - 100 km/h time (measured on official timer)
                if (zeroToHundredTime === null && prevV * 3.6 < 100.0 && currentSpeedKmh >= 100.0 && rolloutCrossTime !== null) {
                    const frac100 = (100.0 - prevV * 3.6) / Math.max(1e-9, (currentSpeedKmh - prevV * 3.6));
                    zeroToHundredTime = prevOfficialTime + frac100 * dt;
                }

                // Record official checkpoints (60ft, 100m, 150m, 201m, 203m)
                if (rolloutCrossTime !== null) {
                    for (let d of targetDistances) {
                        const key = d.toFixed(3);
                        if (!recordedCheckpoints[key] && prevXOfficial < d && xOfficial >= d) {
                            const frac = (d - prevXOfficial) / Math.max(1e-9, (xOfficial - prevXOfficial));
                            const exactTime = prevOfficialTime + frac * dt;
                            const exactSpeedMps = prevV + frac * (v - prevV);
                            recordedCheckpoints[key] = {
                                distanceM: d,
                                timeSec: exactTime,
                                speedKmh: exactSpeedMps * 3.6,
                                gear: currentGearIdx + 1,
                                rpm: Math.round(rpm)
                            };
                        }
                    }
                }

                // Sample telemetry every 10ms after stage rollout clears
                if (rolloutCrossTime !== null && (Math.round(rawTime * 1000) % 10 === 0 || xOfficial >= finishTargetDist)) {
                    telemetry.push({
                        t: currentOfficialTime,
                        x: Math.max(0, xOfficial),
                        vKmh: currentSpeedKmh,
                        aG: a / g,
                        rpm: rpm,
                        gear: currentGearIdx + 1,
                        isShifting: isShifting,
                        isLimiterCut: isLimiterCut,
                        fDrive: fDrive,
                        fDragTotal: fAero + fRoll + fSlope
                    });
                }
            }

            const finalCp = recordedCheckpoints[finishTargetDist.toFixed(3)];
            return {
                modeKey,
                shiftDelayMs,
                totalMass,
                wheelRadius,
                wheelCircumference,
                primaryRatio,
                finalRatio,
                baseReduction,
                gearData,
                peakTorqueNm,
                peakWheelForceN,
                hitLimiterInGear6,
                hitLimiterBeforeShift,
                zeroToHundredTime,
                topSpeedKmh,
                checkpoints: recordedCheckpoints,
                telemetry,
                finishTime: finalCp ? finalCp.timeSec : (telemetry.length ? telemetry[telemetry.length - 1].t : 0),
                finishSpeedKmh: finalCp ? finalCp.speedKmh : topSpeedKmh
            };
        }

        /***********************************************************************
         * 3. MASTER SIMULATION RUNNER & UI UPDATER
         ***********************************************************************/
        function runAllSimulations() {
            const params = getInputParams();

            // Update Top Header & Left Panel Badges
            const totalMass = params.bikeMass + params.riderMass;
            const pwrToWeight = (params.hp / (totalMass / 1000)).toFixed(1);
            document.getElementById('headerPwrWeight').textContent = `${pwrToWeight} HP/Ton`;
            document.getElementById('headerRpmSummary').textContent = `${params.shiftRpm} / ${params.limitRpm} RPM`;
            document.getElementById('lblTotalMass').textContent = `${totalMass.toFixed(1)} kg`;

            const wheelRadius = (params.wheelDiaMm / 1000) / 2;
            const wheelCirc = 2 * Math.PI * wheelRadius;
            document.getElementById('lblWheelRadius').textContent = `${wheelRadius.toFixed(3)} m`;
            document.getElementById('lblWheelCirc').textContent = `${wheelCirc.toFixed(3)} m`;

            const primRatio = params.primDriven / params.primDrive;
            const finalRatio = params.rearSprocket / params.frontSprocket;
            document.getElementById('lblPrimaryRatio').textContent = primRatio.toFixed(3);
            document.getElementById('lblFinalRatio').textContent = finalRatio.toFixed(3);

            params.gears.forEach((g, i) => {
                const r = g.driven / g.drive;
                document.getElementById(`lblRatio${i + 1}`).textContent = r.toFixed(3);
            });

            // Update Shift Delay Labels
            document.getElementById('lblClutchMs').textContent = `${params.delayClutchMs} ms`;
            document.getElementById('lblQsMs').textContent = `${params.delayQsMs} ms`;
            document.getElementById('lblMaticMs').textContent = `${params.delayMaticMs} ms`;
            document.querySelectorAll('.lblClutchHdr').forEach(el => el.textContent = params.delayClutchMs);
            document.querySelectorAll('.lblQsHdr').forEach(el => el.textContent = params.delayQsMs);
            document.querySelectorAll('.lblMaticHdr').forEach(el => el.textContent = params.delayMaticMs);

            // Run 1000Hz physics for all 3 transmission systems
            simulationResults.clutch = simulateDragRun(params, params.delayClutchMs, 'clutch');
            simulationResults.quickshifter = simulateDragRun(params, params.delayQsMs, 'quickshifter');
            simulationResults.matic = simulateDragRun(params, params.delayMaticMs, 'matic');

            const activeRes = simulationResults[activeTransMode];

            // Update Mode & Rollout Headers
            const modeNames = {
                clutch: `Kopling Manual (${params.delayClutchMs} ms)`,
                quickshifter: `Quickshifter (${params.delayQsMs} ms)`,
                matic: `Sistem Matic (${params.delayMaticMs} ms)`
            };
            document.getElementById('lblActiveModeTitle').textContent = modeNames[activeTransMode];
            document.getElementById('lblRolloutActive').textContent = params.rolloutM > 0
                ? `Sensor Lampu Drag (Rollout ${Math.round(params.rolloutM * 100)}cm)`
                : `True Zero Start (0.00m tanpa Rollout)`;
            document.getElementById('activeShiftDelayBadge').textContent = `${activeRes.shiftDelayMs} ms / shift`;

            document.getElementById('lblZeroToHundred').textContent = activeRes.zeroToHundredTime !== null
                ? `${activeRes.zeroToHundredTime.toFixed(2)} s`
                : `N/A`;
            document.getElementById('lblTopSpeedSummary').textContent = `${activeRes.topSpeedKmh.toFixed(1)} km/h`;

            // Update Shift RPM vs Limit RPM Warning Banner & Gear 6 Limiter Status Badge
            const warnBanner = document.getElementById('rpmWarningBanner');
            const g6Badge = document.getElementById('lblGear6StatusBadge');

            if (params.shiftRpm > params.limitRpm) {
                warnBanner.className = ' rounded-lg p-2.5 text-[11px] font-mono border bg-red-500/15 border-red-500/50 text-red-300';
                warnBanner.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-red-400 mr-1"></i> <strong>PERINGATAN:</strong> Shift RPM (${params.shiftRpm}) disetel lebih tinggi dari Limit RPM (${params.limitRpm}). Mesin menyentuh limiter terlebih dahulu (rev bounce) sebelum oper gigi!`;
            } else if (activeRes.hitLimiterInGear6) {
                warnBanner.className = ' rounded-lg p-2.5 text-[11px] font-mono border bg-amber-500/15 border-amber-500/50 text-amber-300';
                warnBanner.innerHTML = `<i class="fa-solid fa-circle-exclamation text-amber-400 mr-1"></i> <strong>INFO RASIO:</strong> Gigi 6 sudah menyentuh Limit RPM (${params.limitRpm} RPM @ ${activeRes.gearData[5].speedAtLimitKmh.toFixed(1)} km/h) sebelum garis finish ${params.trackLengthM}m!`;
            } else {
                warnBanner.className = 'hidden';
            }

            if (activeRes.hitLimiterInGear6) {
                g6Badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/20 text-red-400 border border-red-500/40';
                g6Badge.textContent = 'G6 MENTOK LIMITER!';
            } else {
                g6Badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30';
                g6Badge.textContent = 'G6 BELUM LIMIT';
            }

            // Update Tachometer Bar Markers
            const gaugeMaxRpm = Math.max(params.limitRpm + 1200, params.shiftRpm + 1200, 15000);
            document.getElementById('lblGaugeMaxRpm').textContent = gaugeMaxRpm;
            document.getElementById('lblBarShiftRpm').textContent = params.shiftRpm;
            document.getElementById('lblBarLimitRpm').textContent = params.limitRpm;
            document.getElementById('rpmBarShiftLine').style.left = `${Math.min(98, (params.shiftRpm / gaugeMaxRpm) * 100)}%`;
            document.getElementById('rpmBarLimitLine').style.left = `${Math.min(99, (params.limitRpm / gaugeMaxRpm) * 100)}%`;

            // Render Cards, Comparison Table, Gearbox Table & Live Text Report
            renderCheckpointCards(activeRes, params);
            renderComparisonTable(params);
            renderGearboxTable(activeRes, params);
            updateTextReportBox(params);

            // Configure Animation Timeline Scrubber
            animState.maxTime = Math.max(
                simulationResults.clutch.finishTime,
                simulationResults.quickshifter.finishTime,
                simulationResults.matic.finishTime
            );
            const scrubber = document.getElementById('raceTimeScrubber');
            scrubber.max = animState.maxTime.toFixed(2);
            if (!animState.running) {
