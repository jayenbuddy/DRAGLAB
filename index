        /***********************************************************************
         * 5. LIVE 203M DRAG STRIP CANVAS ANIMATION (3-LANE COMPARISON)
         ***********************************************************************/
        function sampleTelemetryAtTime(simRes, timeSec) {
            const arr = simRes.telemetry;
            if (!arr || arr.length === 0) return { t: 0, x: 0, vKmh: 0, rpm: 8500, gear: 1, isShifting: false, isLimiterCut: false };
            if (timeSec <= 0) return arr[0];
            if (timeSec >= arr[arr.length - 1].t) return arr[arr.length - 1];

            let low = 0, high = arr.length - 1;
            while (low <= high) {
                const mid = (low + high) >> 1;
                if (arr[mid].t < timeSec) low = mid + 1;
                else high = mid - 1;
            }
            const idx = Math.max(1, low);
            const p0 = arr[idx - 1];
            const p1 = arr[idx];
            const ratio = (timeSec - p0.t) / Math.max(1e-6, p1.t - p0.t);
            return {
                t: timeSec,
                x: p0.x + ratio * (p1.x - p0.x),
                vKmh: p0.vKmh + ratio * (p1.vKmh - p0.vKmh),
                rpm: p0.rpm + ratio * (p1.rpm - p0.rpm),
                gear: p1.gear,
                isShifting: p1.isShifting,
                isLimiterCut: p1.isLimiterCut
            };
        }

        function updateDashboardAndTrackAtTime(timeSec) {
