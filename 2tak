<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0a0f14">
  <title>Ninja 150 2T | Simulator Drag 203 m</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0a0f14;
      --panel: #111922;
      --panel-2: #151f2a;
      --line: #263442;
      --text: #e7eef5;
      --muted: #91a1b1;
      --amber: #ffb02e;
      --cyan: #5bd6e8;
      --green: #57d69a;
      --red: #ff6b6b;
      --purple: #c2a5ff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background:
        radial-gradient(ellipse at 82% -18%, rgba(91,214,232,.11), transparent 35rem),
        linear-gradient(rgba(38,52,66,.18) 1px, transparent 1px),
        linear-gradient(90deg, rgba(38,52,66,.18) 1px, transparent 1px),
        var(--bg);
      background-size: auto, 28px 28px, 28px 28px, auto;
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      line-height: 1.45;
    }
    button, input, textarea { font: inherit; }
    button { cursor: pointer; }
    .topbar {
      border-bottom: 1px solid var(--line);
      background: rgba(10,15,20,.92);
      position: sticky;
      z-index: 5;
      top: 0;
      backdrop-filter: blur(12px);
    }
    .topbar-inner, main { width: min(1500px, calc(100% - 32px)); margin: 0 auto; }
    .topbar-inner { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .brand { display: flex; align-items: center; gap: 12px; font-weight: 800; letter-spacing: .02em; }
    .brand-mark { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: var(--amber); color: #16130d; font-weight: 900; }
    .brand small { display: block; color: var(--muted); font: 600 10px/1.3 ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; }
    .top-meta { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .pill { border: 1px solid var(--line); color: #c4d1dc; border-radius: 999px; padding: 6px 10px; font: 700 10px ui-monospace, monospace; letter-spacing: .06em; }
    main { padding: 24px 0 52px; }
    .hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin: 0 0 22px; }
    .eyebrow { color: var(--amber); font: 800 11px ui-monospace, monospace; letter-spacing: .15em; text-transform: uppercase; }
    h1 { font-size: clamp(25px, 3.5vw, 42px); line-height: 1.04; letter-spacing: -.04em; margin: 8px 0 10px; }
    .hero p { max-width: 780px; color: var(--muted); margin: 0; font-size: 14px; }
    .hero-tag { flex: 0 0 auto; padding: 10px 13px; border: 1px solid rgba(255,176,46,.38); border-radius: 12px; color: #ffd58d; background: rgba(255,176,46,.08); font: 700 11px ui-monospace, monospace; }
    .layout { display: grid; grid-template-columns: minmax(290px, 360px) minmax(0, 1fr); gap: 18px; align-items: start; }
    .panel { border: 1px solid var(--line); background: rgba(17,25,34,.96); border-radius: 16px; box-shadow: 0 18px 50px rgba(0,0,0,.16); }
    .controls { padding: 16px; position: sticky; top: 84px; max-height: calc(100vh - 100px); overflow: auto; }
    .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
    h2, h3, p { margin-top: 0; }
    h2 { font-size: 16px; margin-bottom: 0; letter-spacing: -.01em; }
    h3 { font-size: 12px; text-transform: uppercase; letter-spacing: .11em; color: #b9c7d4; margin: 0 0 12px; }
    .section { padding: 15px 0; border-top: 1px solid var(--line); }
    .section:first-of-type { border-top: 0; padding-top: 4px; }
    .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .field { min-width: 0; }
    .field.full { grid-column: 1 / -1; }
    label { display: block; color: #aebdca; font-size: 11px; font-weight: 650; margin-bottom: 5px; }
    .unit { color: #718393; font-weight: 500; }
    input, textarea {
      width: 100%;
      border: 1px solid #2b3a48;
      background: #0b1219;
      color: var(--text);
      border-radius: 8px;
      outline: 0;
    }
    input { height: 36px; padding: 0 9px; font: 700 12px ui-monospace, monospace; }
    textarea { min-height: 180px; padding: 10px; resize: vertical; font: 11px/1.65 ui-monospace, SFMono-Regular, Consolas, monospace; tab-size: 2; }
    input:focus, textarea:focus { border-color: var(--amber); box-shadow: 0 0 0 2px rgba(255,176,46,.12); }
    input[type="checkbox"] { width: 14px; height: 14px; accent-color: var(--amber); vertical-align: middle; margin: 0 6px 0 0; }
    .help { color: #7f909f; font-size: 10px; line-height: 1.5; margin: 7px 0 0; }
    .gear-head, .gear-row { display: grid; grid-template-columns: 52px 1fr 1fr 58px; gap: 7px; align-items: center; }
    .gear-head { color: #6f8292; font: 700 9px ui-monospace, monospace; text-transform: uppercase; letter-spacing: .08em; margin: 0 0 6px; }
    .gear-row { margin: 5px 0; }
    .gear-label { color: #aebdca; font: 700 11px ui-monospace, monospace; }
    .gear-row input { height: 31px; padding: 0 6px; text-align: center; }
    .gear-ratio { text-align: right; color: var(--cyan); font: 700 10px ui-monospace, monospace; }
    .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; position: sticky; bottom: -16px; padding: 12px 0 2px; background: linear-gradient(transparent, var(--panel) 18%); }
    .btn { border: 1px solid var(--line); border-radius: 9px; padding: 10px 11px; font-size: 11px; font-weight: 800; transition: .15s ease; }
    .btn:hover { transform: translateY(-1px); filter: brightness(1.08); }
    .btn-primary { background: var(--amber); color: #17130a; border-color: var(--amber); }
    .btn-secondary { background: #17222d; color: var(--text); }
    .btn-quiet { background: transparent; color: #b8c6d2; }
    .dashboard { min-width: 0; display: grid; gap: 16px; }
    .notice { padding: 13px 15px; border-color: rgba(255,176,46,.32); background: rgba(255,176,46,.055); color: #decaa8; font-size: 11px; }
    .notice strong { color: #ffcf75; }
    .notice.error { border-color: rgba(255,107,107,.45); color: #ffd0d0; background: rgba(255,107,107,.07); }
    .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .stat { padding: 15px; min-height: 98px; }
    .stat-label { color: var(--muted); font: 700 10px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
    .stat-value { font: 800 clamp(22px, 2.7vw, 31px)/1.15 ui-monospace, monospace; margin: 8px 0 3px; letter-spacing: -.05em; }
    .stat-foot { color: #748697; font-size: 10px; }
    .amber { color: var(--amber); } .cyan { color: var(--cyan); } .green { color: var(--green); } .purple { color: var(--purple); }
    .chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .chart-card { padding: 15px; min-width: 0; }
    .chart-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
    .chart-title h2 { font-size: 13px; }
    .chart-title span { color: #7d8d9a; font: 10px ui-monospace, monospace; }
    canvas { display: block; width: 100%; height: 250px; }
    #engineChart { height: 270px; }
    .data-card { padding: 16px; }
    .table-wrap { overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; min-width: 530px; font: 11px ui-monospace, monospace; }
    th { color: #8495a4; text-align: left; font-size: 9px; letter-spacing: .08em; text-transform: uppercase; padding: 9px 8px; border-bottom: 1px solid var(--line); }
    td { padding: 10px 8px; border-bottom: 1px solid rgba(38,52,66,.65); color: #d6e0e8; }
    tr:last-child td { border-bottom: 0; }
    td:last-child, th:last-child { text-align: right; }
    .small { color: var(--muted); font-size: 11px; }
    .inline-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .source-list { margin: 10px 0 0; padding-left: 18px; color: #92a1ae; font-size: 10px; }
    .source-list li { margin: 5px 0; }
    a { color: #82dff0; }
    .footer-note { color: #70818f; font-size: 10px; margin-top: 12px; }
    #toast { position: fixed; bottom: 18px; left: 50%; transform: translate(-50%, 20px); opacity: 0; pointer-events: none; background: #203140; border: 1px solid #496073; border-radius: 10px; padding: 10px 14px; color: #edf6fb; font-size: 12px; transition: .2s; z-index: 10; }
    #toast.show { transform: translate(-50%, 0); opacity: 1; }
    @media (max-width: 950px) {
      .layout { grid-template-columns: 1fr; }
      .controls { position: static; max-height: none; }
      .actions { position: static; background: transparent; padding-top: 10px; }
    }
    @media (max-width: 680px) {
      .topbar-inner, main { width: min(100% - 22px, 1500px); }
      .topbar-inner { min-height: 58px; }
      .top-meta { display: none; }
      main { padding-top: 18px; }
      .hero { display: block; }
      .hero-tag { display: inline-block; margin-top: 14px; }
      .stat-grid { grid-template-columns: 1fr 1fr; }
      .chart-grid { grid-template-columns: 1fr; }
      canvas { height: 225px; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="brand-mark">2T</div>
        <div>NINJA 150 <small>Drag telemetry · 203 m</small></div>
      </div>
      <div class="top-meta">
        <span class="pill">149 cc · 1 SILINDER</span>
        <span class="pill">KIPS · 6 SPEED</span>
        <span class="pill">MODEL FISIKA 500 Hz</span>
      </div>
    </div>
  </header>

  <main>
    <div class="hero">
      <div>
        <div class="eyebrow">Simulator performa 2-tak</div>
        <h1>Kawasaki Ninja 150 RR</h1>
        <p>Model akselerasi garis lurus dengan peta torsi mesin, rasio transmisi KR150, perpindahan gigi, traksi ban, hambatan udara, angin, dan kemiringan lintasan. Baseline mengikuti spesifikasi Ninja RR; peta torsi selain titik spesifikasi adalah estimasi dan bisa diganti dengan data dyno mesin Anda.</p>
      </div>
      <div class="hero-tag">BASELINE RR · KONDISI DAPAT DIUBAH</div>
    </div>

    <div class="layout">
      <aside class="panel controls">
        <div class="panel-heading"><h2>Setelan pengujian</h2><span class="pill">EDITABLE</span></div>

        <section class="section">
          <h3>Mesin & perpindahan gigi</h3>
          <div class="fields">
            <div class="field"><label for="shiftRpm">RPM pindah gigi</label><input id="shiftRpm" class="sim-input" type="number" value="10500" min="4000" max="15000" step="100"></div>
            <div class="field"><label for="rpmCeiling">Batas RPM model</label><input id="rpmCeiling" class="sim-input" type="number" value="12000" min="5000" max="16000" step="100"></div>
            <div class="field"><label for="launchRpm">RPM saat lepas kopling</label><input id="launchRpm" class="sim-input" type="number" value="8500" min="2000" max="14000" step="100"></div>
            <div class="field"><label for="clutchSec">Waktu kait kopling <span class="unit">(s)</span></label><input id="clutchSec" class="sim-input" type="number" value="0.42" min="0.05" max="2" step="0.01"></div>
            <div class="field"><label for="shiftCutMs">Jeda tenaga saat shift <span class="unit">(ms)</span></label><input id="shiftCutMs" class="sim-input" type="number" value="140" min="0" max="1000" step="10"></div>
            <div class="field"><label for="drivetrainEff">Efisiensi drivetrain <span class="unit">(%)</span></label><input id="drivetrainEff" class="sim-input" type="number" value="90" min="60" max="100" step="1"></div>
          </div>
          <p class="help">RPM pindah dan jeda shift adalah setelan pengendara. Batas RPM model hanya mencegah mesin melewati rentang peta; itu bukan klaim limiter atau batas aman pabrikan.</p>
        </section>

        <section class="section">
          <h3>Bobot, sasis & ban</h3>
          <div class="fields">
            <div class="field"><label for="bikeMass">Bobot motor basah <span class="unit">(kg)</span></label><input id="bikeMass" class="sim-input" type="number" value="134" min="70" max="250" step="0.5"></div>
            <div class="field"><label for="riderMass">Bobot pengendara <span class="unit">(kg)</span></label><input id="riderMass" class="sim-input" type="number" value="70" min="30" max="180" step="0.5"></div>
            <div class="field"><label for="wheelDia">Diameter efektif roda belakang <span class="unit">(mm)</span></label><input id="wheelDia" class="sim-input" type="number" value="608" min="450" max="700" step="1"></div>
            <div class="field"><label for="tireMu">Koefisien grip ban <span class="unit">(μ)</span></label><input id="tireMu" class="sim-input" type="number" value="0.90" min="0.3" max="2" step="0.01"></div>
            <div class="field"><label for="rearFraction">Beban statis roda belakang <span class="unit">(%)</span></label><input id="rearFraction" class="sim-input" type="number" value="58" min="35" max="75" step="1"></div>
            <div class="field"><label for="cgHeight">Tinggi pusat massa <span class="unit">(m)</span></label><input id="cgHeight" class="sim-input" type="number" value="0.55" min="0.3" max="1.2" step="0.01"></div>
            <div class="field"><label for="wheelbase">Jarak sumbu roda <span class="unit">(m)</span></label><input id="wheelbase" class="sim-input" type="number" value="1.305" min="1" max="2" step="0.001"></div>
            <div class="field"><label for="rotMass">Allowance massa rotasi <span class="unit">(%)</span></label><input id="rotMass" class="sim-input" type="number" value="4" min="0" max="20" step="0.5"></div>
          </div>
          <p class="help">Diameter geometris ban belakang 110/80-17 sekitar 608 mm; diameter efektif berubah karena merek, tekanan, beban, dan keausan ban.</p>
        </section>

        <section class="section">
          <h3>Rasio transmisi standar KR150</h3>
          <div class="fields">
            <div class="field"><label for="primaryDrive">Primer penggerak <span class="unit">(gigi)</span></label><input id="primaryDrive" class="sim-input" type="number" value="22" min="5" max="100" step="1"></div>
            <div class="field"><label for="primaryDriven">Primer digerakkan <span class="unit">(gigi)</span></label><input id="primaryDriven" class="sim-input" type="number" value="72" min="5" max="100" step="1"></div>
            <div class="field"><label for="frontSprocket">Sproket depan <span class="unit">(gigi)</span></label><input id="frontSprocket" class="sim-input" type="number" value="14" min="5" max="50" step="1"></div>
            <div class="field"><label for="rearSprocket">Sproket belakang <span class="unit">(gigi)</span></label><input id="rearSprocket" class="sim-input" type="number" value="39" min="10" max="80" step="1"></div>
          </div>
          <div style="margin-top:12px">
            <div class="gear-head"><span>Gigi</span><span>Input</span><span>Output</span><span style="text-align:right">Rasio</span></div>
            <div id="gearRows"></div>
          </div>
          <p class="help">Rasio dihitung dari jumlah gigi input/output. Pastikan pasangan gear cocok dengan tahun dan gearbox motor yang diuji.</p>
        </section>

        <section class="section">
          <h3>Lintasan & kondisi udara</h3>
          <div class="fields">
            <div class="field"><label for="trackLength">Jarak uji <span class="unit">(m)</span></label><input id="trackLength" class="sim-input" type="number" value="203" min="60" max="1000" step="0.1"></div>
            <div class="field"><label for="rolloutCm">Rollout <span class="unit">(cm)</span></label><input id="rolloutCm" class="sim-input" type="number" value="0" min="0" max="100" step="1"></div>
            <div class="field"><label for="wind">Angin depan (+) / belakang (-) <span class="unit">(km/j)</span></label><input id="wind" class="sim-input" type="number" value="0" min="-100" max="100" step="1"></div>
            <div class="field"><label for="slope">Tanjakan (+) / turunan (-) <span class="unit">(%)</span></label><input id="slope" class="sim-input" type="number" value="0" min="-20" max="20" step="0.1"></div>
            <div class="field"><label for="cda">CdA motor + pengendara <span class="unit">(m²)</span></label><input id="cda" class="sim-input" type="number" value="0.45" min="0.15" max="1.2" step="0.01"></div>
            <div class="field"><label for="crr">Rolling resistance <span class="unit">(Crr)</span></label><input id="crr" class="sim-input" type="number" value="0.015" min="0.003" max="0.08" step="0.001"></div>
            <div class="field"><label for="temperature">Suhu udara <span class="unit">(°C)</span></label><input id="temperature" class="sim-input" type="number" value="25" min="-10" max="55" step="1"></div>
            <div class="field"><label for="altitude">Ketinggian lintasan <span class="unit">(m)</span></label><input id="altitude" class="sim-input" type="number" value="0" min="-400" max="5000" step="10"></div>
            <div class="field full"><label><input id="airCorrection" class="sim-input" type="checkbox" checked> Koreksi torsi mesin terhadap massa jenis udara</label><p class="help">Pakai untuk peta dyno mentah. Matikan bila kurva sudah dikoreksi atmosfer atau kurva diukur pada kondisi pengujian yang sama.</p></div>
          </div>
        </section>

        <section class="section">
          <h3>Peta torsi mesin</h3>
          <div class="field">
            <label for="torqueMap">RPM, torsi poros engkol <span class="unit">(Nm)</span></label>
            <textarea id="torqueMap" spellcheck="false">2000,4.5
3000,6.8
4000,9.5
5000,12.2
6000,15.1
7000,17.5
8000,19.4
9000,20.0
10000,19.6
11000,18.2
11500,15.0
12000,0</textarea>
            <p class="help">Satu titik per baris, format <code>RPM, Nm</code>. Angka baseline mengikuti puncak spesifikasi RR (20 Nm @ 9.000 rpm; 21 kW @ 11.000 rpm), lalu diinterpolasi sebagai perkiraan karakter KIPS. Ganti seluruh tabel dengan kurva hasil dyno mesin untuk kalibrasi motor tertentu. Tidak ada tambahan boost KIPS di luar kurva ini.</p>
          </div>
        </section>

        <div class="actions">
          <button id="runBtn" class="btn btn-primary">Hitung simulasi</button>
          <button id="presetBtn" class="btn btn-secondary">Pulihkan baseline RR</button>
          <button id="copyBtn" class="btn btn-quiet">Salin time slip</button>
          <button id="csvBtn" class="btn btn-quiet">Unduh telemetry CSV</button>
        </div>
      </aside>

      <section class="dashboard">
        <div id="modelNote" class="panel notice">
          <strong>Model kalibrasi:</strong> spesifikasi motor dan rasio gigi bersumber dari data Ninja 150 RR/KR150. Kurva torsi baseline di antara titik spesifikasi, grip, aerodinamika, massa rotasi, dan waktu kopling adalah asumsi; hasil simulasi bukan pengganti dyno atau pengukuran GPS.
        </div>

        <div class="stat-grid">
          <article class="panel stat"><div class="stat-label">ET · jarak uji</div><div id="statEt" class="stat-value amber">—</div><div id="statTrack" class="stat-foot">203 m, true zero</div></article>
          <article class="panel stat"><div class="stat-label">Kecepatan akhir</div><div id="statTrap" class="stat-value cyan">—</div><div class="stat-foot">Interpolasi pada garis finish</div></article>
          <article class="panel stat"><div class="stat-label">0–100 km/j</div><div id="stat0100" class="stat-value green">—</div><div class="stat-foot">Waktu dari titik start model</div></article>
          <article class="panel stat"><div class="stat-label">Akselerasi puncak</div><div id="statAccel" class="stat-value purple">—</div><div class="stat-foot">Termasuk pembatas traksi</div></article>
        </div>

        <div class="chart-grid">
          <article class="panel chart-card">
            <div class="chart-title"><h2>Kecepatan vs jarak</h2><span>km/j · m</span></div>
            <canvas id="speedChart" aria-label="Grafik kecepatan terhadap jarak"></canvas>
          </article>
          <article class="panel chart-card">
            <div class="chart-title"><h2>RPM mesin vs waktu</h2><span>RPM · s</span></div>
            <canvas id="rpmChart" aria-label="Grafik RPM terhadap waktu"></canvas>
          </article>
        </div>

        <article class="panel chart-card">
          <div class="chart-title"><h2>Peta torsi & tenaga mesin</h2><span><b style="color:#57d69a">— Torsi (Nm)</b> &nbsp; <b style="color:#ffb02e">— Tenaga (skala visual)</b></span></div>
          <canvas id="engineChart" aria-label="Grafik peta torsi dan tenaga mesin"></canvas>
        </article>

        <article class="panel data-card">
          <div class="panel-heading"><div><h2>Time slip & titik uji</h2><div class="small">Kecepatan dan waktu dibaca pada jarak resmi dari titik start simulasi.</div></div></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Titik</th><th>Waktu</th><th>Kecepatan</th><th>Gigi</th><th>RPM</th></tr></thead>
              <tbody id="slipBody"></tbody>
            </table>
          </div>
        </article>

        <article class="panel data-card">
          <div class="panel-heading"><div><h2>Kecepatan teoritis per gigi</h2><div class="small">Kecepatan roda tanpa slip pada RPM pindah yang dipilih.</div></div></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Gigi</th><th>Rasio gearbox</th><th>Rasio total</th><th>km/j @ shift</th><th>RPM setelah upshift</th></tr></thead>
              <tbody id="gearSpeedBody"></tbody>
            </table>
          </div>
        </article>

        <article class="panel data-card">
          <div class="panel-heading"><h2>Data & batas model</h2></div>
          <div class="small">Versi ini menggunakan integrasi gerak 2 ms, kurva torsi poros engkol, rasio reduksi aktual yang dimasukkan, batas gaya ban belakang dengan estimasi transfer beban, hambatan udara relatif terhadap angin, rolling resistance, dan gaya gravitasi pada slope. KIPS tidak dimodelkan sebagai aktuator terpisah karena titik buka bergantung kondisi dan versi; efeknya harus sudah tercermin dalam peta torsi dyno.</div>
          <ul class="source-list">
            <li><a href="https://www.kawansakti.com/produk-37-ninja-150-rr.html" target="_blank" rel="noreferrer">Spesifikasi Kawasaki Ninja 150 RR (dealer resmi Kawansakti)</a>: bobot 134 kg, mesin 149 cc 2-langkah dengan KIPS/HSAS, 21 kW @ 11.000 rpm, 20 Nm @ 9.000 rpm, ban belakang 110/80-17, wheelbase 1.305 mm, dan rasio gigi.</li>
            <li><a href="https://www.motorcyclemanuals.info/files/Motocycles%20%26%20ATVs/Kawasaki/Kawasaki%20KR%20150%20Service%20Manual.pdf" target="_blank" rel="noreferrer">Manual servis Kawasaki KR150 (salinan)</a>: konstruksi mesin 148 cc, bore × stroke 59 × 54,4 mm, primary 72/22, final 39/14, dan rasio gearbox.</li>
          </ul>
          <div class="footer-note">Angka antar tahun, pasar, dan varian Ninja 150 dapat berbeda. Cocokkan tahun/model motor, ukuran sproket, bobot siap jalan, tekanan ban, serta hasil dyno sebelum memakai hasil untuk membandingkan setup.</div>
        </article>
      </section>
    </div>
  </main>
  <div id="toast" role="status"></div>

  <script>
    "use strict";
    const BASELINE_MAP = [
      [2000, 4.5], [3000, 6.8], [4000, 9.5], [5000, 12.2],
      [6000, 15.1], [7000, 17.5], [8000, 19.4], [9000, 20.0],
      [10000, 19.6], [11000, 18.2], [11500, 15.0], [12000, 0]
    ];
    const BASELINE_FIELDS = {
      shiftRpm: 10500, rpmCeiling: 12000, launchRpm: 8500, clutchSec: 0.42,
      shiftCutMs: 140, drivetrainEff: 90, bikeMass: 134, riderMass: 70,
      wheelDia: 608, tireMu: 0.90, rearFraction: 58, cgHeight: 0.55,
      wheelbase: 1.305, rotMass: 4, primaryDrive: 22, primaryDriven: 72,
      frontSprocket: 14, rearSprocket: 39, trackLength: 203, rolloutCm: 0,
      wind: 0, slope: 0, cda: 0.45, crr: 0.015, temperature: 25, altitude: 0
    };
    const BASELINE_GEARS = [[10,27],[17,29],[20,26],[22,24],[21,20],[22,19]];
    let latestResult = null;
    let latestParams = null;

    function numberValue(id) {
      const el = document.getElementById(id);
      const n = el ? Number(el.value) : NaN;
      return Number.isFinite(n) ? n : NaN;
    }
    function setToast(message) {
      const toast = document.getElementById("toast");
      toast.textContent = message;
      toast.classList.add("show");
      clearTimeout(setToast.timer);
      setToast.timer = setTimeout(function() { toast.classList.remove("show"); }, 2400);
    }
    function renderGearInputs(values) {
      const host = document.getElementById("gearRows");
      host.innerHTML = "";
      values.forEach(function(pair, i) {
        const row = document.createElement("div");
        row.className = "gear-row";
        row.innerHTML = '<span class="gear-label">G' + (i + 1) + '</span>' +
          '<input class="sim-input gear-drive" aria-label="Gear ' + (i + 1) + ' input teeth" type="number" min="5" max="60" step="1" value="' + pair[0] + '">' +
          '<input class="sim-input gear-driven" aria-label="Gear ' + (i + 1) + ' output teeth" type="number" min="5" max="60" step="1" value="' + pair[1] + '">' +
          '<span class="gear-ratio" id="ratio' + i + '">—</span>';
        host.appendChild(row);
      });
      host.querySelectorAll("input").forEach(function(input) {
        input.addEventListener("change", runSimulation);
      });
    }
    function readTorqueMap() {
      const rows = document.getElementById("torqueMap").value.split(/\r?\n/);
      const points = [];
      rows.forEach(function(row) {
        const line = row.trim();
        if (!line) return;
        const parts = line.split(/[;,\t ]+/).filter(Boolean);
        if (parts.length < 2) throw new Error("Format peta torsi harus RPM, Nm pada setiap baris.");
        const rpm = Number(parts[0]);
        const torque = Number(parts[1]);
        if (!Number.isFinite(rpm) || !Number.isFinite(torque) || rpm <= 0 || torque < 0) {
          throw new Error("Peta torsi berisi angka yang tidak valid. Gunakan RPM positif dan torsi 0 atau lebih.");
        }
        points.push([rpm, torque]);
      });
      points.sort(function(a,b) { return a[0] - b[0]; });
      if (points.length < 3) throw new Error("Masukkan sedikitnya tiga titik pada peta torsi.");
      for (let i = 1; i < points.length; i++) {
        if (points[i][0] === points[i-1][0]) throw new Error("RPM pada peta torsi tidak boleh duplikat.");
      }
      return points;
    }
    function getParams() {
      const p = {};
      Object.keys(BASELINE_FIELDS).forEach(function(id) {
        p[id] = numberValue(id);
        if (!Number.isFinite(p[id])) throw new Error("Periksa nilai input " + id + ".");
      });
      p.efficiency = p.drivetrainEff / 100;
      p.airCorrection = document.getElementById("airCorrection").checked;
      p.mass = p.bikeMass + p.riderMass;
      p.radius = p.wheelDia / 2000;
      p.circumference = 2 * Math.PI * p.radius;
      p.primaryRatio = p.primaryDriven / p.primaryDrive;
      p.finalRatio = p.rearSprocket / p.frontSprocket;
      p.shiftDelay = p.shiftCutMs / 1000;
      p.rollout = p.rolloutCm / 100;
      p.gears = Array.from(document.querySelectorAll(".gear-row")).map(function(row) {
        const drive = Number(row.querySelector(".gear-drive").value);
        const driven = Number(row.querySelector(".gear-driven").value);
        if (!(drive > 0 && driven > 0)) throw new Error("Jumlah gigi transmisi harus lebih dari nol.");
        return { drive: drive, driven: driven, ratio: driven / drive };
      });
      p.curve = readTorqueMap();
      if (p.shiftRpm >= p.rpmCeiling) throw new Error("RPM pindah gigi harus di bawah batas RPM model.");
      if (p.launchRpm >= p.rpmCeiling) throw new Error("RPM lepas kopling harus di bawah batas RPM model.");
      if (p.gears.length !== 6) throw new Error("Simulator memerlukan enam rasio gigi.");
      return p;
    }
    function interpolateTorque(rpm, curve) {
      if (rpm <= curve[0][0]) {
        const fraction = rpm / curve[0][0];
        return Math.max(0, curve[0][1] * fraction);
      }
      for (let i = 1; i < curve.length; i++) {
        if (rpm <= curve[i][0]) {
          const f = (rpm - curve[i-1][0]) / (curve[i][0] - curve[i-1][0]);
          return Math.max(0, curve[i-1][1] + f * (curve[i][1] - curve[i-1][1]));
        }
      }
      return 0;
    }
    function getAirDensity(tempC, altitudeM) {
      const kelvin = tempC + 273.15;
      const basePressure = 101325 * Math.pow(Math.max(0.1, 1 - 2.25577e-5 * altitudeM), 5.25588);
      return basePressure / (287.05 * kelvin);
    }
    function interpolateState(a, b, frac) {
      const out = {};
      Object.keys(a).forEach(function(key) {
        if (typeof a[key] === "number" && typeof b[key] === "number") out[key] = a[key] + (b[key] - a[key]) * frac;
      });
      return out;
    }
    function simulate(p) {
      const dt = 0.002;
      const maxTime = 30;
      const rho = getAirDensity(p.temperature, p.altitude);
      const engineAirFactor = p.airCorrection ? rho / 1.184 : 1;
      const gradeAngle = Math.atan(p.slope / 100);
      const rollout = p.rollout;
      const finish = Math.max(60, p.trackLength);
      const targets = [18.288, 60, 100, 150, 201, p.trackLength].filter(function(x, i, a) {
        return x >= 0 && x <= p.trackLength && a.indexOf(x) === i;
      }).sort(function(a,b) { return a-b; });
      const records = {};
      targets.forEach(function(d) { records[d] = null; });
      let rawTime = 0, xRaw = 0, x = -rollout, v = 0, gear = 0, shiftTimer = 0;
      let rolloutTime = rollout <= 0 ? 0 : null;
      let peakAccel = 0, time60 = null, time100 = null, topSpeed = 0;
      const telemetry = [];
      const totalMass = p.mass;
      const effectiveMass = totalMass * (1 + p.rotMass / 100);
      const wheelOmegaToRpm = 60 / (2 * Math.PI);
      const airHeadwind = p.wind / 3.6;
      let previous = { t: 0, x: x, v: 0, rpm: p.launchRpm, gear: 1, tq: 0, accel: 0, force: 0, drag: 0, shifting: false };
      let step = 0;
      while (x < finish && rawTime < maxTime) {
        const prev = previous;
        const active = p.gears[gear];
        const totalRatio = p.primaryRatio * active.ratio * p.finalRatio;
        const coupledRpm = (v / p.radius) * totalRatio * wheelOmegaToRpm;
        const launchProgress = Math.min(1, rawTime / Math.max(0.05, p.clutchSec));
        let rpm = gear === 0 && coupledRpm < p.launchRpm ? p.launchRpm : Math.max(1000, coupledRpm);
        let shifting = false;
        let driveForce = 0;
        let engineTorque = 0;

        if (shiftTimer > 0) {
          shifting = true;
          shiftTimer = Math.max(0, shiftTimer - dt);
        } else if (rpm >= p.shiftRpm && gear < p.gears.length - 1) {
          gear += 1;
          shiftTimer = p.shiftDelay;
          shifting = shiftTimer > 0;
          const newRatio = p.primaryRatio * p.gears[gear].ratio * p.finalRatio;
          rpm = Math.max(1000, (v / p.radius) * newRatio * wheelOmegaToRpm);
        }

        const currentTotalRatio = p.primaryRatio * p.gears[gear].ratio * p.finalRatio;
        if (!shifting && rpm < p.rpmCeiling) {
          engineTorque = interpolateTorque(rpm, p.curve) * engineAirFactor;
          const clutchFactor = gear === 0 ? launchProgress : 1;
          const wheelTorque = engineTorque * currentTotalRatio * p.efficiency * clutchFactor;
          driveForce = wheelTorque / p.radius;
        }

        const vRel = v + airHeadwind;
        const aeroForce = 0.5 * rho * p.cda * vRel * Math.abs(vRel);
        const rollForce = (v > 0.01 || driveForce > 0) ? p.crr * totalMass * 9.80665 * Math.cos(gradeAngle) : 0;
        const slopeForce = totalMass * 9.80665 * Math.sin(gradeAngle);
        const resistance = aeroForce + rollForce + slopeForce;
        const rawDrive = driveForce;
        for (let n = 0; n < 8; n++) {
          const aGuess = (driveForce - resistance) / effectiveMass;
          const rearNormal = Math.min(totalMass * 9.80665 * Math.cos(gradeAngle), Math.max(0, totalMass * 9.80665 * (p.rearFraction / 100) +
            totalMass * aGuess * p.cgHeight / p.wheelbase));
          const tractionLimit = p.tireMu * rearNormal;
          driveForce = Math.min(rawDrive, tractionLimit);
        }
        let accel = (driveForce - resistance) / effectiveMass;
        if (v <= 0 && accel < 0) accel = 0;
        const nextV = Math.max(0, v + accel * dt);
        const avgV = (v + nextV) / 2;
        const nextRawX = xRaw + avgV * dt;
        const nextX = nextRawX - rollout;
        const nextTime = rawTime + dt;
        const nextRpm = rpm;
        const nextState = {
          t: nextTime, x: nextX, v: nextV, rpm: nextRpm,
          gear: gear + 1, tq: engineTorque, accel: accel,
          force: driveForce, drag: resistance, shifting: shifting
        };

        if (rolloutTime === null && prev.x < 0 && nextX >= 0) {
          const startFraction = (0 - prev.x) / Math.max(1e-9, nextX - prev.x);
          rolloutTime = prev.t + (nextTime - prev.t) * startFraction;
        }
        if (prev.v * 3.6 < 60 && nextV * 3.6 >= 60 && time60 === null) {
          const f60 = (60 / 3.6 - prev.v) / Math.max(1e-9, nextV - prev.v);
          time60 = prev.t + (nextTime - prev.t) * f60;
        }
        if (prev.v * 3.6 < 100 && nextV * 3.6 >= 100 && time100 === null) {
          const f100 = (100 / 3.6 - prev.v) / Math.max(1e-9, nextV - prev.v);
          time100 = prev.t + (nextTime - prev.t) * f100;
        }
        if (accel > peakAccel) peakAccel = accel;
        if (nextV * 3.6 > topSpeed) topSpeed = nextV * 3.6;
        targets.forEach(function(d) {
          if (records[d] === null && prev.x < d && nextX >= d) {
            const f = (d - prev.x) / Math.max(1e-9, nextX - prev.x);
            records[d] = interpolateState(prev, nextState, f);
          } else if (records[d] === null && d === 0 && prev.x <= 0 && nextX >= 0) {
            const f = (0 - prev.x) / Math.max(1e-9, nextX - prev.x);
            records[d] = interpolateState(prev, nextState, f);
          }
        });

        xRaw = nextRawX; x = nextX; v = nextV; rawTime = nextTime;
        step++;
        if (step % 10 === 0 || x >= finish) {
          telemetry.push({
            t: nextTime, x: nextX, speed: nextV * 3.6, rpm: nextRpm,
            gear: gear + 1, tq: engineTorque, accel: accel,
            drive: driveForce, drag: resistance, shifting: shifting
          });
        }
        previous = nextState;
      }
      const complete = x >= finish;
      const officialStartTime = rolloutTime === null ? 0 : rolloutTime;
      telemetry.forEach(function(point) { point.t -= officialStartTime; });
      Object.keys(records).forEach(function(distance) {
        if (records[distance]) records[distance].t -= officialStartTime;
      });
      const officialFinishTime = records[p.trackLength] ? records[p.trackLength].t : Math.max(0, rawTime - officialStartTime);
      return {
        telemetry: telemetry, records: records, complete: complete,
        time60: time60 === null ? null : time60 - officialStartTime, time100: time100 === null ? null : time100 - officialStartTime, peakAccel: peakAccel,
        topSpeed: topSpeed, totalTime: officialFinishTime, finish: finish, rho: rho, engineAirFactor: engineAirFactor
      };
    }
    function formatTime(value) { return value === null || !Number.isFinite(value) ? "—" : value.toFixed(3) + " s"; }
    function recordAt(result, distance) {
      const keys = Object.keys(result.records).map(Number);
      if (result.records[distance]) return result.records[distance];
      if (result.records[result.finish]) return result.records[result.finish];
      if (!keys.length) return null;
      let best = keys[0];
      keys.forEach(function(key) { if (Math.abs(key-distance) < Math.abs(best-distance)) best = key; });
      return result.records[best];
    }
    function updateRatioLabels(p) {
      document.querySelectorAll(".gear-ratio").forEach(function(el, i) {
        el.textContent = p.gears[i].ratio.toFixed(3);
      });
    }
    function updateGearSpeedTable(p) {
      const body = document.getElementById("gearSpeedBody");
      body.innerHTML = "";
      p.gears.forEach(function(g, i) {
        const total = p.primaryRatio * g.ratio * p.finalRatio;
        const speed = (p.shiftRpm / 60 / total) * p.circumference * 3.6;
        const nextRpm = i < p.gears.length - 1 ? p.shiftRpm * p.gears[i+1].ratio / g.ratio : null;
        const row = document.createElement("tr");
        row.innerHTML = "<td>G" + (i+1) + "</td><td>" + g.ratio.toFixed(3) + "</td><td>" + total.toFixed(3) +
          "</td><td>" + speed.toFixed(1) + "</td><td>" + (nextRpm === null ? "—" : Math.round(nextRpm).toLocaleString("id-ID") + " rpm") + "</td>";
        body.appendChild(row);
      });
    }
    function updateSlipTable(p, result) {
      const body = document.getElementById("slipBody");
      body.innerHTML = "";
      const rows = [
        { label: "60 ft / 18,288 m", d: 18.288 },
        { label: "60 km/j", speedOnly: 60 },
        { label: "100 km/j", speedOnly: 100 },
        { label: "100 m", d: 100 },
        { label: "150 m", d: 150 },
        { label: "201 m", d: 201 },
        { label: p.trackLength.toFixed(1) + " m / finish", d: p.trackLength }
      ];
      rows.forEach(function(item) {
        const row = document.createElement("tr");
        if (item.speedOnly) {
          const t = item.speedOnly === 60 ? result.time60 : result.time100;
          row.innerHTML = "<td>" + item.label + "</td><td>" + formatTime(t) + "</td><td>—</td><td>—</td><td>—</td>";
        } else {
          const rec = recordAt(result, item.d);
          const valid = rec && rec.t != null && (item.d <= result.finish);
          row.innerHTML = "<td>" + item.label + "</td><td>" + (valid ? formatTime(rec.t) : "di luar jarak") +
            "</td><td>" + (valid ? (rec.v * 3.6).toFixed(1) + " km/j" : "—") +
            "</td><td>" + (valid ? "G" + Math.round(rec.gear) : "—") +
            "</td><td>" + (valid ? Math.round(rec.rpm).toLocaleString("id-ID") : "—") + "</td>";
        }
        body.appendChild(row);
      });
    }
    function drawChart(canvas, series, options) {
      const rect = canvas.getBoundingClientRect();
      const ratio = window.devicePixelRatio || 1;
      const width = Math.max(260, rect.width);
      const height = Math.max(190, rect.height);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      const ctx = canvas.getContext("2d");
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, width, height);
      const left = 49, right = 14, top = 18, bottom = 34;
      const plotW = width-left-right, plotH = height-top-bottom;
      const maxX = options.maxX || Math.max(1, ...series.flatMap(function(s) { return s.data.map(function(d) { return d.x; }); }));
      const maxY = options.maxY || Math.max(1, ...series.flatMap(function(s) { return s.data.map(function(d) { return d.y; }); })) * 1.12;
      ctx.font = "10px ui-monospace, monospace";
      ctx.textBaseline = "middle";
      for (let i = 0; i <= 4; i++) {
        const y = top + plotH - plotH*i/4;
        ctx.strokeStyle = "rgba(124,145,162,.18)";
        ctx.beginPath(); ctx.moveTo(left, y); ctx.lineTo(left+plotW, y); ctx.stroke();
        ctx.fillStyle = "#8193a2"; ctx.textAlign = "right";
        ctx.fillText(options.yFormat ? options.yFormat(maxY*i/4) : (maxY*i/4).toFixed(0), left-7, y);
        const x = left + plotW*i/4;
        ctx.beginPath(); ctx.moveTo(x, top); ctx.lineTo(x, top+plotH); ctx.stroke();
        ctx.textAlign = "center";
        ctx.fillText(options.xFormat ? options.xFormat(maxX*i/4) : (maxX*i/4).toFixed(0), x, top+plotH+17);
      }
      series.forEach(function(s) {
        if (!s.data.length) return;
        ctx.beginPath();
        ctx.strokeStyle = s.color;
        ctx.lineWidth = s.width || 2;
        s.data.forEach(function(point, i) {
          const px = left + point.x/maxX*plotW;
          const py = top + plotH - point.y/maxY*plotH;
          if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        });
        ctx.stroke();
      });
      if (options.xLabel || options.yLabel) {
        ctx.fillStyle = "#8495a4"; ctx.font = "9px ui-monospace, monospace";
        if (options.xLabel) { ctx.textAlign = "right"; ctx.fillText(options.xLabel, width-right, height-7); }
        if (options.yLabel) { ctx.save(); ctx.translate(10, top+plotH/2); ctx.rotate(-Math.PI/2); ctx.textAlign = "center"; ctx.fillText(options.yLabel, 0, 0); ctx.restore(); }
      }
    }
    function drawAll(p, result) {
      const telemetry = result.telemetry;
      const speedData = telemetry.map(function(d) { return {x: Math.max(0,d.x), y: d.speed}; });
      const rpmData = telemetry.map(function(d) { return {x: d.t, y: d.rpm}; });
      const tEnd = telemetry.length ? telemetry[telemetry.length-1].t : 1;
      const rpmMax = Math.max(p.rpmCeiling, ...rpmData.map(function(d) { return d.y; }));
      drawChart(document.getElementById("speedChart"), [{data:speedData,color:"#5bd6e8"}], {
        maxX: p.trackLength, maxY: Math.max(80, result.topSpeed*1.12), xLabel:"JARAK (m)", yLabel:"KM/J",
        xFormat:function(v) { return v.toFixed(0); }, yFormat:function(v) { return v.toFixed(0); }
      });
      drawChart(document.getElementById("rpmChart"), [{data:rpmData,color:"#ffb02e"}], {
        maxX: tEnd, maxY: rpmMax*1.05, xLabel:"WAKTU (s)", yLabel:"RPM",
        xFormat:function(v) { return v.toFixed(1); }, yFormat:function(v) { return (v/1000).toFixed(1)+"k"; }
      });
      const torqueData = p.curve.map(function(point) { return {x:point[0], y:point[1]}; });
      const powerData = p.curve.map(function(point) {
        return {x:point[0], y:point[1]*point[0]*2*Math.PI/60/1000};
      });
      const maxTq = Math.max(...torqueData.map(function(d) { return d.y; })) * 1.12;
      drawChart(document.getElementById("engineChart"), [
        {data:torqueData,color:"#57d69a",width:2.5},
        {data:powerData.map(function(d) { return {x:d.x,y:d.y*maxTq/25}; }),color:"#ffb02e",width:2}
      ], {
        maxX: Math.max(p.rpmCeiling, torqueData[torqueData.length-1].x),
        maxY: maxTq, xLabel:"RPM", yLabel:"TORQUE (Nm) / POWER SKALA",
        xFormat:function(v) { return (v/1000).toFixed(0)+"k"; }, yFormat:function(v) { return v.toFixed(0); }
      });
    }
    function runSimulation() {
      try {
        const p = getParams();
        updateRatioLabels(p);
        updateGearSpeedTable(p);
        const result = simulate(p);
        latestResult = result;
        latestParams = p;
        document.getElementById("statEt").textContent = result.complete ? formatTime(result.totalTime) : "belum finish";
        const finishRecord = recordAt(result, p.trackLength);
        document.getElementById("statTrap").textContent = result.complete && finishRecord ? (finishRecord.v * 3.6).toFixed(1) + " km/j" : "—";
        document.getElementById("stat0100").textContent = result.time100 === null ? "—" : result.time100.toFixed(2) + " s";
        document.getElementById("statAccel").textContent = (result.peakAccel / 9.80665).toFixed(2) + " g";
        document.getElementById("statTrack").textContent = p.trackLength.toFixed(1) + " m, " + (p.rollout > 0 ? "rollout " + (p.rollout*100).toFixed(0) + " cm" : "true zero");
        document.getElementById("modelNote").classList.remove("error");
        document.getElementById("modelNote").innerHTML = "<strong>Simulasi selesai.</strong> Massa total " + p.mass.toFixed(1) +
          " kg · rasio final " + p.finalRatio.toFixed(3) + " · densitas udara " + result.rho.toFixed(3) +
          " kg/m³ · koreksi torsi udara x" + result.engineAirFactor.toFixed(3) + " · WOT · integrasi 2 ms. Hasil bergantung pada peta torsi dan asumsi grip/aerodinamika.";
        updateSlipTable(p, result);
        drawAll(p, result);
      } catch (error) {
        const note = document.getElementById("modelNote");
        note.classList.add("error");
        note.innerHTML = "<strong>Input belum bisa dihitung:</strong> " + error.message;
      }
    }
    function restoreBaseline() {
      Object.keys(BASELINE_FIELDS).forEach(function(id) {
        document.getElementById(id).value = BASELINE_FIELDS[id];
      });
      document.getElementById("torqueMap").value = BASELINE_MAP.map(function(p) { return p[0] + "," + p[1]; }).join("\n");
      document.getElementById("airCorrection").checked = true;
      renderGearInputs(BASELINE_GEARS);
      runSimulation();
      setToast("Setelan baseline Ninja 150 RR dipulihkan.");
    }
    function buildReport() {
      if (!latestParams || !latestResult) return "Belum ada hasil simulasi.";
      const p = latestParams, r = latestResult;
      const lines = [
        "NINJA 150 RR 2T — SIMULASI DRAG " + p.trackLength.toFixed(1) + " m",
        "Bobot total: " + p.mass.toFixed(1) + " kg | Shift: " + p.shiftRpm + " rpm | Launch: " + p.launchRpm + " rpm",
        "Rasio: primer " + p.primaryRatio.toFixed(3) + " | final " + p.finalRatio.toFixed(3) + " | drivetrain " + p.drivetrainEff + "%",
        "ET: " + (r.complete ? r.totalTime.toFixed(3) + " s" : "belum finish") + " | Trap: " +
          (r.complete && recordAt(r,p.trackLength) ? (recordAt(r,p.trackLength).v*3.6).toFixed(1) + " km/j" : "—"),
        "0-60 km/j: " + formatTime(r.time60) + " | 0-100 km/j: " + formatTime(r.time100),
        "Koreksi densitas mesin: " + (p.airCorrection ? "aktif" : "nonaktif"),
        "Shift (gigi input/output): " + p.gears.map(function(g,i) { return (i+1) + ":" + g.drive + "/" + g.driven; }).join("  "),
        "Baseline map adalah estimasi; hasil dyno/GPS diperlukan untuk kalibrasi."
      ];
      [18.288,100,150,201,p.trackLength].forEach(function(d) {
        if (d <= p.trackLength) {
          const rec = recordAt(r,d);
          if (rec) lines.push(d.toFixed(3) + " m: " + rec.t.toFixed(3) + " s @ " + (rec.v*3.6).toFixed(1) + " km/j");
        }
      });
      return lines.join("\n");
    }
    async function copyReport() {
      const report = buildReport();
      try {
        await navigator.clipboard.writeText(report);
        setToast("Time slip disalin.");
      } catch (e) {
        const area = document.createElement("textarea");
        area.value = report;
        document.body.appendChild(area); area.select();
        document.execCommand("copy"); area.remove();
        setToast("Time slip disalin.");
      }
    }
    function downloadCsv() {
      if (!latestResult || !latestResult.telemetry.length) { setToast("Jalankan simulasi dahulu."); return; }
      const header = "time_s,distance_m,speed_kmh,rpm,gear,engine_torque_nm,acceleration_m_s2,drive_force_n,resistance_n,shift_cut";
      const rows = latestResult.telemetry.map(function(d) {
        return [d.t.toFixed(4),d.x.toFixed(3),d.speed.toFixed(3),d.rpm.toFixed(0),d.gear,d.tq.toFixed(3),d.accel.toFixed(4),d.drive.toFixed(2),d.drag.toFixed(2),d.shifting?1:0].join(",");
      });
      const blob = new Blob([header + "\n" + rows.join("\n")], {type:"text/csv;charset=utf-8"});
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = "ninja150rr-telemetry.csv"; a.click();
      setTimeout(function() { URL.revokeObjectURL(url); }, 500);
      setToast("Telemetry CSV diunduh.");
    }
    document.getElementById("runBtn").addEventListener("click", runSimulation);
    document.getElementById("presetBtn").addEventListener("click", restoreBaseline);
    document.getElementById("copyBtn").addEventListener("click", copyReport);
    document.getElementById("csvBtn").addEventListener("click", downloadCsv);
    document.querySelectorAll(".sim-input").forEach(function(input) {
      input.addEventListener("change", runSimulation);
    });
    window.addEventListener("resize", function() {
      if (latestParams && latestResult) drawAll(latestParams, latestResult);
    });
    renderGearInputs(BASELINE_GEARS);
    runSimulation();
  </script>
</body>
</html>
